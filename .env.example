# ─── Admin ───────────────────────────────────────────────────────────────────
# Code d'accès à l'interface /admin (choisir un code fort, ex. 12 caractères)
# NE PAS préfixer par PUBLIC_ — reste côté serveur uniquement
ADMIN_ACCESS_CODE=your_admin_code_here

# ─── Sanity ──────────────────────────────────────────────────────────────────
# Créer le projet Sanity avec la région EU (obligatoire — RGPD)
# Dashboard : https://www.sanity.io/manage
# Laisser vide tant que le projet Sanity n'est pas créé (catalogue local utilisé)
# Format : uniquement a-z, 0-9 et tirets (ex. abc12xyz) — voir sanity.io/manage
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Token d'écriture pour l'interface admin — rôle Editor minimum
# Paramètres Sanity → API → Tokens → Add API token
# NE PAS préfixer par PUBLIC_ — jamais exposé au client
SANITY_API_WRITE_TOKEN=your_write_token_here

# ─── Email (formulaire de contact) ───────────────────────────────────────────
# Choisir Resend ou Postmark
# Resend : https://resend.com
RESEND_API_KEY=your_resend_api_key_here
CONTACT_EMAIL_TO=marionderiot.archi@gmail.com
CONTACT_EMAIL_FROM=noreply@marionderiot.com

# ─── Site ────────────────────────────────────────────────────────────────────
# URL publique du site (sans trailing slash)
PUBLIC_SITE_URL=https://marionderiot.com
