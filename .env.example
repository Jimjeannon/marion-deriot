# ─── La seule variable obligatoire ───────────────────────────────────────────
# Token d'écriture Sanity, requis par l'interface /admin (rôle Editor minimum).
# Sanity → Paramètres → API → Tokens → Add API token.
# NE PAS préfixer par PUBLIC_ — ne doit jamais être commité ni exposé au client.
SANITY_API_WRITE_TOKEN=your_write_token_here

# ─── Tout le reste est facultatif ────────────────────────────────────────────
# Les valeurs par défaut vivent dans le code ; ces variables ne servent qu'à les
# remplacer ponctuellement (autre environnement, autre dataset, autre code).
#
#   ADMIN_ACCESS_CODE        défaut : voir CODE_ADMIN_PAR_DEFAUT
#                            dans src/lib/admin-auth.ts
#   PUBLIC_SANITY_PROJECT_ID défaut : voir src/lib/sanity-config.ts
#   PUBLIC_SANITY_DATASET    défaut : production
#
# ADMIN_ACCESS_CODE=
# PUBLIC_SANITY_PROJECT_ID=
# PUBLIC_SANITY_DATASET=production

# ─── Email du formulaire de contact ──────────────────────────────────────────
# Sans clé Resend, le formulaire journalise et ne renvoie pas d'erreur.
# Ne définir RESEND_API_KEY qu'avec une vraie clé — une valeur d'exemple
# provoquerait un appel authentifié voué à l'échec.
# RESEND_API_KEY=
CONTACT_EMAIL_TO=marionderiot.archi@gmail.com
CONTACT_EMAIL_FROM=noreply@marionderiot.com

# ─── Site ────────────────────────────────────────────────────────────────────
# URL publique, sans slash final. Alimente les balises canoniques et Open Graph.
PUBLIC_SITE_URL=https://marionderiot.com
