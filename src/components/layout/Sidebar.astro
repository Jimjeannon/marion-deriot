---
/**
 * Sidebar — Navigation principale gauche fixe (desktop ≥ 1024px)
 * Sur mobile/tablette, masquée et remplacée par le Drawer.
 */
import { getDict, getLangUrl } from '@/i18n';
import type { Locale } from '@/i18n';
import DrawerToggle from './DrawerToggle.astro';
import ProjectsDropdown from './ProjectsDropdown.astro';

interface Props {
  lang: Locale;
  activeNav?: 'home' | 'projects' | 'info';
}

const { lang, activeNav } = Astro.props;
const t = getDict(lang);

/** Slug du projet affiché (fiche individuelle) pour le menu déroulant */
const currentProjectSlug = Astro.url.pathname.match(/\/(?:projets|projects)\/([^/]+)\/?$/)?.[1];

const homeUrl = getLangUrl(lang, '/home');
const projectsUrl = getLangUrl(lang, '/projets');
const infoUrl = getLangUrl(lang, '/info');

const socialLinks = [
  {
    name: t.info.social.instagram,
    href: 'https://www.instagram.com/marionderiot.archi/',
    label: 'Instagram Marion Dériot',
  },
  {
    name: t.info.social.linkedin,
    href: 'https://www.linkedin.com/in/marion-d%C3%A9riot-41b175135/',
    label: 'LinkedIn Marion Dériot',
  },
  {
    name: t.info.social.pinterest,
    href: 'https://fr.pinterest.com/marionderiot/_saved/',
    label: 'Pinterest Marion Dériot',
  },
];
---

<!-- Bouton hamburger — visible uniquement sur mobile -->
<DrawerToggle lang={lang} />

<!-- Sidebar desktop — masquée sur mobile/tablette -->
<aside
  class="sidebar max-lg:hidden py-8 px-5 z-40 flex flex-col"
  aria-label="Navigation principale"
>
  <!-- ─── Haut : logo + navigation ─────────────────────────────────────── -->
  <div class="flex flex-col flex-1 min-h-0">
    <a
      href={homeUrl}
      class="sidebar-logo block mb-6 flex-shrink-0"
      aria-label="Marion Dériot — Retour à l'accueil"
    >
      <span class="sidebar-logo-name block font-serif font-bold text-anthracite-300">
        Marion Dériot
      </span>
      <span class="sidebar-logo-tagline block font-sans uppercase text-greige-300">
        Architecture intérieure &amp; Design
      </span>
    </a>

    <!-- ─── Navigation principale ───────────────────────────────────────── -->
    <nav aria-label="Menu principal" class="sidebar-nav flex-1 min-h-0 overflow-y-auto overflow-x-visible pr-1">
      <ul class="space-y-0" role="list">
        <!-- Home -->
        <li>
          <a
            href={homeUrl}
            class="nav-item"
            aria-current={activeNav === 'home' ? 'page' : undefined}
          >
            {t.nav.home}
          </a>
        </li>

        <!-- Info -->
        <li>
          <a
            href={infoUrl}
            class="nav-item"
            aria-current={activeNav === 'info' ? 'page' : undefined}
          >
            {t.nav.info}
          </a>
        </li>

        <!-- Projets avec dropdown -->
        <li>
          <ProjectsDropdown
            lang={lang}
            isActive={activeNav === 'projects'}
            currentSlug={currentProjectSlug}
          />
        </li>
      </ul>
    </nav>
  </div>

  <!-- ─── Séparateur visuel — fondu bas masquant le contenu qui scroll ───── -->
  <div class="sidebar-nav-fade" aria-hidden="true"></div>

  <!-- ─── Bas de sidebar : réseaux sociaux + liens légaux ─────────────────── -->
  <div class="mt-auto pt-4 flex-shrink-0 flex flex-col gap-2.5">
    <!-- Liens réseaux sociaux — noms en clair.
         Filet de séparation au-dessus : délimite la partie Projets de la
         partie Réseaux sociaux (identique au filet des liens légaux). -->
    <nav aria-label="Réseaux sociaux" class="pt-2.5 border-t border-greige-300/30">
      <ul class="flex flex-col gap-1.5" role="list">
        {socialLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="block font-sans text-xs tracking-[0.15em] uppercase text-greige-300 hover:text-anthracite-300 transition-colors duration-400"
              aria-label={link.label}
            >
              {link.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Liens légaux — très petit et discret, empreinte minimale -->
    <nav aria-label="Liens légaux" class="pt-1.5 border-t border-greige-300/30">
      <!-- Interlignes resserrés au maximum : 2px entre les liens -->
      <ul class="flex flex-col gap-[2px] leading-none" role="list">
        <li>
          <a
            href={getLangUrl(lang, '/mentions-legales')}
            class="text-[0.55rem] leading-none font-sans text-greige-400 hover:text-anthracite-300 transition-colors duration-400 tracking-wide"
          >
            Mentions légales
          </a>
        </li>
        <li>
          <a
            href={getLangUrl(lang, '/politique-confidentialite')}
            class="text-[0.55rem] leading-none font-sans text-greige-400 hover:text-anthracite-300 transition-colors duration-400 tracking-wide"
          >
            Politique de confidentialité
          </a>
        </li>
        <li>
          <a
            href={getLangUrl(lang, '/cookies')}
            class="text-[0.55rem] leading-none font-sans text-greige-400 hover:text-anthracite-300 transition-colors duration-400 tracking-wide"
          >
            Cookies
          </a>
        </li>
        <li>
          <p class="text-[0.55rem] leading-none font-sans text-greige-400">
            © 2026 Marion Dériot
          </p>
        </li>
      </ul>
    </nav>
  </div>
</aside>

<style>
  /* ── Lockup logo — la tagline fait exactement la largeur du nom ────────── */
  .sidebar-logo {
    width: max-content;
    max-width: 100%;
  }

  .sidebar-logo-name {
    font-size: 1.75rem;
    letter-spacing: 0.02em;
    line-height: 1.15;
    white-space: nowrap;
  }

  /* Tagline : espacement standard, calibrée sur la largeur du nom */
  .sidebar-logo-tagline {
    margin-top: 0.45rem;
    font-size: 0.54rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    line-height: 1.4;
    white-space: nowrap;
  }

  /* ── Scrollbar invisible sur la nav de la sidebar ─────────────────────── */
  .sidebar-nav {
    scrollbar-width: none;          /* Firefox */
    -ms-overflow-style: none;       /* IE / Edge legacy */
  }
  .sidebar-nav::-webkit-scrollbar {
    display: none;                  /* Chrome / Safari / Webkit */
  }

  /* ── Fondu bas — indique visuellement qu'il y a du contenu à scroller ─── */
  .sidebar-nav-fade {
    flex-shrink: 0;
    height: 2rem;
    margin-top: -2rem;              /* chevauche le bas de la nav */
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      var(--color-sidebar-bg, #F5F3EF) 100%
    );
    position: relative;
    z-index: 1;
  }
</style>
