---
/**
 * Galerie projet — navigation au clic, double cadrant plein écran.
 *
 * Design v5 (juin 2026) — demande cliente : plus de scroll, navigation au clic.
 *  - UN cadre blanc par paire (double cadrant), une paire visible à la fois
 *  - Transition : crossfade doux entre les paires (cohérent avec le diaporama home)
 *  - Clic sur la moitié droite de l'image → paire suivante ; moitié gauche → précédente
 *    (curseurs flèche sur mesure, zones annoncées aux lecteurs d'écran)
 *  - Flèches ‹ › + compteur en bas à droite, clavier (← → ↑ ↓), swipe mobile
 *  - Header fixe : titre + localisation + surface
 *  - prefers-reduced-motion : transitions instantanées
 */
import type { SiteProject } from '@/lib/projects';
import type { Locale } from '@/i18n';
import { getDict } from '@/i18n';
import { getLocalized } from '@/lib/projects';
import {
  GALLERY_WIDTHS,
  buildImageSrcSet,
  resolveImageUrl,
  type SanityImage,
} from '@/lib/sanity';

interface Props {
  project: SiteProject;
  lang: Locale;
}

const { project, lang } = Astro.props;
const t = getDict(lang);

const allImages: SanityImage[] = project.gallery ?? [];
const hasGallery = allImages.length > 0;
const title = getLocalized(project.title, lang);

/**
 * Chaque image est déclinée en plusieurs largeurs, en AVIF et en WebP.
 *
 * Auparavant une URL unique en 2 400 px servait tous les cas — la même image
 * pour un cadre de 1 100 px sur grand écran et pour un téléphone de 390 px de
 * large. Comme chaque photo est en outre présente deux fois dans le document
 * (jeu desktop en paires, jeu mobile en solo), le poids de la page grimpait
 * très vite : c'est le principal frein aux performances des fiches projet.
 */
const images = allImages.map((img) => ({
  src: resolveImageUrl(img, 1600) ?? '',
  srcSet: buildImageSrcSet(img, GALLERY_WIDTHS),
  alt: img.alt ? getLocalized(img.alt, lang) : title,
}));

/** Deux images par cadre au-dessus de 768 px, une seule en dessous. */
const PAIR_SIZES = '(min-width: 768px) 46vw, 92vw';
const SOLO_SIZES = '92vw';

// Grouper en paires de 2
const pairs: (typeof images)[] = [];
for (let i = 0; i < images.length; i += 2) {
  pairs.push(images.slice(i, i + 2));
}
const totalPairs = pairs.length;

// Ligne d'info à afficher sous le titre
const metaParts: string[] = [];
if (project.location) metaParts.push(getLocalized(project.location, lang));
if (project.surface) metaParts.push(project.surface);
const metaLine = metaParts.join(' · ');
---

{!hasGallery && (
  <p class="font-sans text-sm text-greige-400 px-10 lg:px-16 py-16">
    {t.projects.imagesComingSoon}
  </p>
)}

{hasGallery && images.length > 0 && (
  <div class="pg-stage" id="pg-stage" role="region" aria-label={`Galerie ${title}`} aria-roledescription="carrousel">
    {/* ── Header — titre + infos, toujours visible ─────────────────────── */}
    <header class="pg-header">
      <h1 class="pg-title">{title}</h1>
      <div class="pg-header-meta">
        {metaLine && <span class="pg-meta">{metaLine}</span>}
      </div>
    </header>

    {/* ── Scène — les cadres blancs superposés, crossfade ──────────────── */}
    <div class="pg-frames">
      {pairs.map((pair, pairIdx) => (
        <div
          class={`pg-pair${pairIdx === 0 ? ' pg-pair--active' : ''}`}
          data-pair={pairIdx}
          aria-hidden={pairIdx === 0 ? 'false' : 'true'}
          aria-label={`Images ${pairIdx * 2 + 1}${pair.length > 1 ? `–${pairIdx * 2 + 2}` : ''} sur ${images.length}`}
        >
          {/* LE CADRE BLANC — contient 2 images, ou 1 seule centrée si impair */}
          <div class={`pg-frame${pair.length === 1 ? ' pg-frame--single' : ''}`}>
            {pair.map((item, imgIdx) => (
              <div class="pg-cell">
                <img
                  src={item.src}
                  srcset={item.srcSet ?? undefined}
                  sizes={item.srcSet ? PAIR_SIZES : undefined}
                  alt={item.alt}
                  class="pg-img"
                  loading={pairIdx === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  fetchpriority={pairIdx === 0 && imgIdx === 0 ? 'high' : 'auto'}
                />
              </div>
            ))}
          </div>
        </div>
      ))}

      {/* ── Mobile : une seule image par vue (jeu de slides dédié) ───────── */}
      {images.map((item, imgIdx) => (
        <div
          class={`pg-single${imgIdx === 0 ? ' pg-single--active' : ''}`}
          data-single={imgIdx}
          aria-hidden={imgIdx === 0 ? 'false' : 'true'}
          aria-label={`Image ${imgIdx + 1} sur ${images.length}`}
        >
          <div class="pg-frame pg-frame--solo">
            <div class="pg-cell">
              <img
                src={item.src}
                srcset={item.srcSet ?? undefined}
                sizes={item.srcSet ? SOLO_SIZES : undefined}
                alt={item.alt}
                class="pg-img"
                loading={imgIdx === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </div>
          </div>
        </div>
      ))}

      {/* ── Zones de clic — moitié gauche : précédent, moitié droite : suivant ──
           (présentes dès qu'il y a plus d'une vue : paires en desktop, images en mobile) */}
      {images.length > 1 && (
        <>
          <button type="button" id="pg-zone-prev" class="pg-zone pg-zone--prev" aria-label="Paire précédente" hidden></button>
          <button type="button" id="pg-zone-next" class="pg-zone pg-zone--next" aria-label="Paire suivante"></button>
        </>
      )}
    </div>

    {/* ── Navigation — sous le cadre, dans le flux (jamais superposée) ──── */}
    <nav class="pg-nav" aria-label="Navigation galerie">
      <button type="button" id="pg-prev" class="pg-btn" aria-label="Paire précédente" disabled>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="pg-icon">
          <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <span class="pg-counter" id="pg-counter" aria-live="polite" aria-atomic="true">
        1&thinsp;/&thinsp;{totalPairs}
      </span>
      <button type="button" id="pg-next" class="pg-btn" aria-label="Paire suivante" disabled={totalPairs <= 1}>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="pg-icon">
          <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </nav>
  </div>
)}

<style is:global>
  /* ── Scène plein écran — de la sidebar au bord droit ───────────────────── */
  .pg-stage {
    position: fixed;
    top: 0; bottom: 0;
    left: var(--sidebar-width);
    right: 0;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    /* Marges extérieures ivoire — le cadre blanc "flotte" dans la page */
    padding: clamp(1.5rem, 2.5vw, 2.5rem) clamp(2rem, 4vw, 4rem);
  }

  @media (max-width: 1023px) {
    .pg-stage { left: 0; padding-top: calc(60px + 0.75rem); }
  }

  /* ── Header — au-dessus du cadre blanc ──────────────────────────────────── */
  .pg-header {
    flex-shrink: 0;
    padding-bottom: 0.85rem;
  }

  .pg-title {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-weight: 400;
    font-size: clamp(0.7rem, 1.1vw, 0.9rem);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #6B6A68;
    margin: 0;
    line-height: 1;
  }

  .pg-header-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.8rem;
    margin-top: 0.4rem;
  }

  .pg-meta {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: #9E9489;
    line-height: 1;
  }

  /* ── Conteneur des paires — superposition, crossfade ───────────────────── */
  .pg-frames {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
  }

  .pg-pair {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;        /* cadre centré horizontalement sur la page */
    justify-content: center;    /* cadre centré verticalement (hauteur = images) */
    opacity: 0;
    z-index: 0;
    pointer-events: none;
    transition: opacity 700ms cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity;
  }

  .pg-pair--active {
    opacity: 1;
    z-index: 1;
    pointer-events: auto;
  }

  /* ── LE CADRE BLANC — épouse les images ─────────────────────────────────── */
  /* Bordure blanche uniforme (26px) en haut, en bas, sur les côtés et entre les
     deux images. Cadre centré à l'écran ; le gris domine tout autour. */
  .pg-frame {
    flex: 0 1 auto;
    min-height: 0;
    width: 100%;
    max-width: 560px;           /* plafond par défaut ; relevé par paliers */
    display: flex;
    background: #FFFFFF;
    padding: 26px;
    gap: 26px;
    align-items: center;
    box-sizing: border-box;
  }

  /* ── Cellule (boîte verticale identique) ─────────────────────────────────── */
  /* Boîte au format vertical 2/3, dimensions STRICTEMENT identiques pour les deux
     (hauteur fixée par palier, largeur = hauteur × 2/3). Toutes les images
     occupent donc la même boîte -> cadre toujours de même hauteur et largeur,
     aucun décalage. */
  .pg-cell {
    flex: 1 1 0;                          /* deux moitiés strictement égales */
    aspect-ratio: 2 / 3;                  /* boîte verticale identique */
    max-height: calc(100dvh - 200px);     /* garde-fou : jamais plus haut que l'écran */
    min-width: 0;
    overflow: hidden;
  }

  .pg-cell--empty {
    background: transparent;
  }

  /* ── Image — remplit la boîte (recadrage) : paysage ramené au format vertical ─ */
  .pg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* ── Image seule (nombre d'images impair) — même boîte verticale ────────── */
  /* Le cadre épouse la boîte (identique aux autres) avec 26px uniformes,
     centré à l'écran. La cellule garde son format vertical (recadrage). */
  /* Sélecteur renforcé (.pg-frame.pg-frame--single) pour primer sur les paliers. */
  .pg-frame.pg-frame--single {
    max-width: min(460px, 70vw);   /* une seule boîte verticale, centrée */
  }

  /* ── Zones de clic — invisibles, curseurs flèche sur mesure ────────────── */
  .pg-zone {
    appearance: none;
    position: absolute;
    top: 0; bottom: 0;
    border: 0;
    background: transparent;
    padding: 0;
    z-index: 10;
  }

  .pg-zone--prev {
    left: 0;
    width: 32%;
    cursor: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='40' height='40' viewBox='0 0 40 40'%3E%3Ccircle cx='20' cy='20' r='19' fill='%23FFFFFF' fill-opacity='0.9'/%3E%3Cpath d='M23 13l-7 7 7 7' stroke='%232A2926' stroke-width='1.5' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E") 20 20, w-resize;
  }

  .pg-zone--next {
    right: 0;
    width: 68%;
    cursor: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='40' height='40' viewBox='0 0 40 40'%3E%3Ccircle cx='20' cy='20' r='19' fill='%23FFFFFF' fill-opacity='0.9'/%3E%3Cpath d='M17 13l7 7-7 7' stroke='%232A2926' stroke-width='1.5' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E") 20 20, e-resize;
  }

  .pg-zone:focus-visible {
    outline: 2px solid rgba(42, 41, 38, 0.45);
    outline-offset: -4px;
  }

  .pg-zone[hidden] { display: none; }

  /* ── Nav — sous le cadre blanc, dans le flux de la scène ───────────────── */
  .pg-nav {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
    padding-top: 0.7rem;
  }

  /* Boutons épurés — chevron seul, ni cercle ni fond */
  .pg-btn {
    appearance: none;
    background: transparent;
    border: 0;
    border-radius: 0;
    color: rgba(42, 41, 38, 0.38);
    width: 30px;
    height: 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color 280ms ease, transform 280ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .pg-btn:hover:not(:disabled),
  .pg-btn:focus-visible:not(:disabled) {
    color: #2A2926;
    background: transparent;
    outline: none;
  }

  #pg-prev:hover:not(:disabled) { transform: translateX(-2px); }
  #pg-next:hover:not(:disabled) { transform: translateX(2px); }

  .pg-btn:disabled { opacity: 0.15; cursor: default; }

  .pg-btn:focus-visible {
    outline: 1px solid rgba(42, 41, 38, 0.35);
    outline-offset: 2px;
  }

  .pg-icon { width: 16px; height: 16px; }

  .pg-counter {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    color: #9E9489;
    white-space: nowrap;
    line-height: 1;
  }

  /* ── Paliers par taille d'écran (pas de fluide) ─────────────────────────── */
  /* La HAUTEUR des images progresse par marches ; les deux images d'une paire
     partagent la même hauteur -> bordure blanche uniforme (26px). Le min() avec
     la hauteur de fenêtre n'est qu'un garde-fou pour ne jamais déborder. */
  /* Largeur du cadre par palier -> taille des deux boîtes (toujours 2/3). */
  @media (min-width: 768px)  { .pg-frame { max-width: 600px; } }
  @media (min-width: 1100px) { .pg-frame { max-width: 720px; } }
  @media (min-width: 1440px) { .pg-frame { max-width: 880px; } }
  @media (min-width: 1920px) { .pg-frame { max-width: 1060px; } }

  /* ── Slides mobiles (une image par vue) — masquées en desktop ─────────── */
  .pg-single { display: none; }

  /* ── Mobile (< 768px) — une seule image par vue, cadre plein écran ─────── */
  @media (max-width: 767px) {
    /* Le cadre occupe tout l'espace disponible sous la barre de nav.
       Le titre et les flèches gardent une marge latérale propre. */
    .pg-stage {
      padding: calc(60px + 0.5rem) 0 0.5rem;
    }
    .pg-header,
    .pg-nav {
      padding-left: 1rem;
      padding-right: 1rem;
    }
    .pg-header { padding-bottom: 0.5rem; }

    /* On bascule du jeu "paires" au jeu "une image" */
    .pg-pair { display: none; }

    .pg-single {
      display: flex;
      position: absolute;
      inset: 0;
      flex-direction: column;
      align-items: stretch;    /* le cadre remplit toute la zone */
      justify-content: stretch;
      opacity: 0;
      z-index: 0;
      pointer-events: none;
      transition: opacity 700ms cubic-bezier(0.4, 0, 0.2, 1);
      will-change: opacity;
    }

    .pg-single--active {
      opacity: 1;
      z-index: 1;
      pointer-events: auto;
    }

    /* Cadre blanc plein écran — bordure uniforme de 22px, identique au desktop. */
    .pg-frame--solo {
      flex: 1 1 auto;
      width: 100%;
      height: 100%;
      max-width: none;
      padding: 22px;
      box-sizing: border-box;
    }

    .pg-frame--solo .pg-cell {
      flex: 1 1 auto;
      width: 100%;
      height: 100%;
      aspect-ratio: auto;
      max-height: none;
    }

    .pg-frame--solo .pg-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    .pg-cell--empty { display: none; }
    /* Zones de navigation 40/60, plus naturelles au pouce */
    .pg-zone--prev { width: 40%; }
    .pg-zone--next { width: 60%; }
  }

  /* ── prefers-reduced-motion ──────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .pg-pair { transition: none !important; }
    .pg-btn  { transition: none !important; }
  }
</style>

{hasGallery && images.length > 0 && (
  <script>
  (function initGallery() {
    const stage    = document.getElementById('pg-stage');
    const prevBtn  = document.getElementById('pg-prev');
    const nextBtn  = document.getElementById('pg-next');
    const counter  = document.getElementById('pg-counter');
    const zonePrev = document.getElementById('pg-zone-prev');
    const zoneNext = document.getElementById('pg-zone-next');
    if (!stage) return;

    // Deux jeux de diapositives : paires (desktop) / une image (mobile).
    const pairsEls   = Array.from(stage.querySelectorAll('.pg-pair'));
    const singlesEls = Array.from(stage.querySelectorAll('.pg-single'));
    const mq = window.matchMedia('(max-width: 767px)');

    // Vue courante : liste d'éléments + classe active associée
    let isMobile = mq.matches;
    let slides   = isMobile ? singlesEls : pairsEls;
    let cls      = isMobile ? 'pg-single--active' : 'pg-pair--active';
    let total    = slides.length || 1;
    let current  = 0;

    function updateUI() {
      if (counter) counter.innerHTML = `${current + 1}&thinsp;/&thinsp;${total}`;
      if (prevBtn) prevBtn.disabled = (current === 0);
      if (nextBtn) nextBtn.disabled = (current === total - 1);
      if (zonePrev) zonePrev.hidden = (current === 0);
      if (zoneNext) zoneNext.hidden = (current === total - 1);
    }

    function goTo(idx) {
      const next = Math.max(0, Math.min(idx, total - 1));
      if (next === current) return;

      slides[current].classList.remove(cls);
      slides[current].setAttribute('aria-hidden', 'true');

      slides[next].classList.add(cls);
      slides[next].setAttribute('aria-hidden', 'false');

      current = next;
      updateUI();
    }

    /* Bascule desktop <-> mobile : on conserve l'image affichée.
       Paire n <-> images 2n et 2n+1. */
    function switchMode(toMobile) {
      const imageIndex = toMobile ? current * 2 : Math.floor(current / 2);

      slides.forEach((el) => {
        el.classList.remove(cls);
        el.setAttribute('aria-hidden', 'true');
      });

      isMobile = toMobile;
      slides   = toMobile ? singlesEls : pairsEls;
      cls      = toMobile ? 'pg-single--active' : 'pg-pair--active';
      total    = slides.length || 1;
      current  = Math.max(0, Math.min(imageIndex, total - 1));

      slides[current]?.classList.add(cls);
      slides[current]?.setAttribute('aria-hidden', 'false');
      updateUI();
    }

    mq.addEventListener('change', (e) => switchMode(e.matches));

    // État initial cohérent si la page s'ouvre en mobile
    if (isMobile) {
      pairsEls.forEach((el) => {
        el.classList.remove('pg-pair--active');
        el.setAttribute('aria-hidden', 'true');
      });
      singlesEls[0]?.classList.add('pg-single--active');
      singlesEls[0]?.setAttribute('aria-hidden', 'false');
    }

    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));
    zonePrev?.addEventListener('click', () => goTo(current - 1));
    zoneNext?.addEventListener('click', () => goTo(current + 1));

    // Clavier — flèches horizontales et verticales
    document.addEventListener('keydown', (e) => {
      if (e.target?.tagName === 'INPUT' || e.target?.tagName === 'TEXTAREA') return;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown' || e.key === 'PageDown') { e.preventDefault(); goTo(current + 1); }
      if (e.key === 'ArrowLeft'  || e.key === 'ArrowUp'   || e.key === 'PageUp'  ) { e.preventDefault(); goTo(current - 1); }
    });

    // Swipe mobile — horizontal prioritaire, vertical accepté
    let touchX = 0;
    let touchY = 0;
    stage.addEventListener('touchstart', (e) => {
      touchX = e.touches[0].clientX;
      touchY = e.touches[0].clientY;
    }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      const dx = touchX - e.changedTouches[0].clientX;
      const dy = touchY - e.changedTouches[0].clientY;
      const threshold = 48;
      if (Math.abs(dx) >= Math.abs(dy) && Math.abs(dx) > threshold) {
        goTo(dx > 0 ? current + 1 : current - 1);
      } else if (Math.abs(dy) > threshold) {
        goTo(dy > 0 ? current + 1 : current - 1);
      }
    }, { passive: true });

    // Bloquer le scroll du body — la galerie est plein écran, sans défilement
    document.body.style.overflow = 'hidden';
    document.addEventListener('astro:before-preparation', () => {
      document.body.style.overflow = '';
    }, { once: true });

    updateUI();
  })();
  </script>
)}
