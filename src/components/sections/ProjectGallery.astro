---
/**
 * Galerie projet — page projet plein écran (pas de scroll) + diaporama immersif.
 *
 * Page projet
 *  - Hauteur = 100dvh, layout flex colonne, jamais de scroll
 *  - Titre large posé en haut, généreux
 *  - 2 images de preview côte à côte qui remplissent la hauteur restante
 *  - Images visibles entièrement (object-fit: contain) : pas de crop
 *
 * Diaporama
 *  - Vrai plein écran, fond doux warm off-white assorti au site (≠ pur noir)
 *  - Images centrées, max-w / max-h 96vw / 92dvh, jamais de crop
 *  - UI minimaliste (compteur + fermer + flèches), auto-hide après 2,5 s
 *  - Crossfade directionnel : l'image entrante glisse légèrement depuis le
 *    côté de la navigation, l'image sortante s'efface vers l'opposé
 *  - Swipe / drag : suivi du doigt en temps réel, snap au seuil
 *  - Préchargement n-1 / n / n+1
 *  - A11y complète, prefers-reduced-motion
 */
import type { SiteProject } from '@/lib/projects';
import type { Locale } from '@/i18n';
import { getDict } from '@/i18n';
import { getLocalized, getPreviewImages } from '@/lib/projects';
import { resolveImageUrl, type SanityImage } from '@/lib/sanity';

interface Props {
  project: SiteProject;
  lang: Locale;
}

const { project, lang } = Astro.props;
const t = getDict(lang);

const previewImages = getPreviewImages(project).slice(0, 2);
const allImages: SanityImage[] = project.gallery ?? [];
const hasGallery = allImages.length > 0;
const title = getLocalized(project.title, lang);

const previewItems = previewImages.map((img) => {
  const index = allImages.findIndex((g) => g === img);
  return {
    src: resolveImageUrl(img, 1800) ?? '',
    alt: img.alt ? getLocalized(img.alt, lang) : '',
    index: index >= 0 ? index : 0,
  };
});

const slideshowImages = allImages.map((img) => ({
  src: resolveImageUrl(img, 2400) ?? '',
  alt: img.alt ? getLocalized(img.alt, lang) : '',
}));

const openLabel = t.projects.openSlideshow;
---

{hasGallery && previewItems.length > 0 && (
  <section class="project-gallery" aria-label={title}>
    <h1 class="project-gallery__title">{title}</h1>

    <div class="project-gallery__grid">
      {previewItems.map((item, i) => (
        <button
          type="button"
          class="project-gallery__cell"
          aria-label={`${openLabel} — ${item.alt}`}
          data-slideshow-trigger
          data-image-index={item.index}
        >
          <img
            src={item.src}
            alt={item.alt}
            class="project-gallery__img"
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            fetchpriority={i === 0 ? 'high' : 'auto'}
          />
        </button>
      ))}
    </div>
  </section>
)}

{!hasGallery && (
  <p class="font-sans text-sm text-greige-400 px-10 lg:px-16 py-16">
    {t.projects.imagesComingSoon}
  </p>
)}

{hasGallery && (
  <div
    id="slideshow-overlay"
    class="slideshow"
    role="dialog"
    aria-modal="true"
    aria-label={title}
    aria-hidden="true"
    tabindex="-1"
    data-chrome="visible"
  >
    {/* Stage — deux <img> empilées pour crossfade directionnel */}
    <div class="slideshow__stage" id="slideshow-stage">
      <img
        id="slideshow-image-a"
        class="slideshow__image slideshow__image--active"
        src=""
        alt=""
        decoding="async"
        draggable="false"
      />
      <img
        id="slideshow-image-b"
        class="slideshow__image"
        src=""
        alt=""
        decoding="async"
        draggable="false"
      />
    </div>

    {/* Top bar : compteur + fermer */}
    <div class="slideshow__topbar">
      <span id="slideshow-counter" class="slideshow__counter" aria-live="polite"></span>
      <button
        type="button"
        id="slideshow-close"
        class="slideshow__btn slideshow__btn--close"
        aria-label={t.projects.closeSlideshow}
      >
        <svg viewBox="0 0 24 24" fill="none" class="slideshow__icon" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    {/* Flèches latérales */}
    <button
      type="button"
      id="slideshow-prev"
      class="slideshow__btn slideshow__btn--prev"
      aria-label={t.projects.prevImage}
    >
      <svg viewBox="0 0 24 24" fill="none" class="slideshow__icon-lg" aria-hidden="true">
        <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <button
      type="button"
      id="slideshow-next"
      class="slideshow__btn slideshow__btn--next"
      aria-label={t.projects.nextImage}
    >
      <svg viewBox="0 0 24 24" fill="none" class="slideshow__icon-lg" aria-hidden="true">
        <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
)}

{hasGallery && (
  <script define:vars={{ slideshowImages, counterTemplate: { fr: 'Image $1 sur $2', en: 'Image $1 of $2' }, lang }}>
  (function initSlideshow() {
    const overlay = document.getElementById('slideshow-overlay');
    const stage = document.getElementById('slideshow-stage');
    const stageA = document.getElementById('slideshow-image-a');
    const stageB = document.getElementById('slideshow-image-b');
    const counter = document.getElementById('slideshow-counter');
    const prevBtn = document.getElementById('slideshow-prev');
    const nextBtn = document.getElementById('slideshow-next');
    const closeBtn = document.getElementById('slideshow-close');

    const images = slideshowImages || [];
    const total = images.length;
    if (total === 0 || !overlay || !stage || !stageA || !stageB) return;

    let current = 0;
    /** 'a' ou 'b' — quel <img> est visible. */
    let activeStage = 'a';
    let lastFocus = null;
    let chromeTimer = null;
    let isAnimating = false;
    const preloaded = new Set();
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ─── Préchargement ────────────────────────────────────────────────────
    function preload(index) {
      if (index < 0 || index >= total || preloaded.has(index)) return;
      const img = new Image();
      img.src = images[index].src;
      preloaded.add(index);
    }
    function preloadNeighbors(index) {
      preload(index);
      preload((index + 1) % total);
      preload((index - 1 + total) % total);
    }

    // ─── Chrome auto-hide ─────────────────────────────────────────────────
    function showChrome() {
      overlay.setAttribute('data-chrome', 'visible');
      if (chromeTimer) clearTimeout(chromeTimer);
      chromeTimer = setTimeout(() => {
        if (overlay.classList.contains('slideshow--open')) {
          overlay.setAttribute('data-chrome', 'hidden');
        }
      }, 2800);
    }

    // ─── Crossfade directionnel ───────────────────────────────────────────
    /**
     * direction : -1 (← prev), +1 (→ next), 0 (saut direct, pas de translate)
     */
    function setImage(index, direction) {
      const data = images[index];
      if (!data) return;
      const showing = activeStage === 'a' ? stageA : stageB;
      const incoming = activeStage === 'a' ? stageB : stageA;

      const sameSrc = incoming.getAttribute('src') === data.src;
      if (!sameSrc) incoming.src = data.src;
      incoming.alt = data.alt || '';

      const commit = () => {
        // Position de départ de l'image entrante (légèrement décalée selon direction)
        if (!prefersReduced && direction !== 0) {
          incoming.style.transition = 'none';
          incoming.style.opacity = '0';
          incoming.style.transform = `translate(calc(-50% + ${direction * 24}px), -50%) scale(0.985)`;
          // Force reflow
          void incoming.offsetWidth;
        }

        // Faire entrer la nouvelle
        incoming.style.transition = '';
        incoming.classList.add('slideshow__image--active');
        incoming.style.opacity = '';
        incoming.style.transform = '';

        // Faire sortir l'ancienne en direction opposée
        if (!prefersReduced && direction !== 0) {
          showing.style.transition = '';
          showing.style.transform = `translate(calc(-50% + ${-direction * 16}px), -50%) scale(0.99)`;
          showing.style.opacity = '0';
        } else {
          showing.style.opacity = '0';
        }
        showing.classList.remove('slideshow__image--active');

        // Nettoyage après l'animation
        setTimeout(() => {
          showing.style.transition = 'none';
          showing.style.transform = '';
          showing.style.opacity = '';
          void showing.offsetWidth;
          showing.style.transition = '';
          isAnimating = false;
        }, 620);

        activeStage = activeStage === 'a' ? 'b' : 'a';
      };

      isAnimating = true;
      let committed = false;
      const safeCommit = () => {
        if (committed) return;
        committed = true;
        commit();
      };

      if (prefersReduced || incoming.complete) {
        safeCommit();
      } else {
        const onLoad = () => safeCommit();
        incoming.addEventListener('load', onLoad, { once: true });
        // Sécurité : on basculera quoi qu'il arrive après 700 ms
        setTimeout(() => {
          incoming.removeEventListener('load', onLoad);
          safeCommit();
        }, 700);
      }
    }

    function updateCounter(index) {
      if (!counter) return;
      const tpl = (counterTemplate && counterTemplate[lang]) || 'Image $1 / $2';
      counter.textContent = tpl
        .replace('$1', String(index + 1).padStart(2, '0'))
        .replace('$2', String(total).padStart(2, '0'));
    }

    // ─── Open / close ─────────────────────────────────────────────────────
    function open(index) {
      lastFocus = document.activeElement;
      current = Math.max(0, Math.min(index, total - 1));
      overlay.classList.add('slideshow--open');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      updateCounter(current);
      preloadNeighbors(current);
      // Crossfade sans direction au premier affichage / réouverture
      setImage(current, 0);
      showChrome();
      // Focus pour pouvoir fermer immédiatement avec Esc
      setTimeout(() => closeBtn && closeBtn.focus({ preventScroll: true }), 60);
    }

    function close() {
      overlay.classList.remove('slideshow--open');
      overlay.setAttribute('aria-hidden', 'true');
      overlay.setAttribute('data-chrome', 'visible');
      if (chromeTimer) clearTimeout(chromeTimer);
      document.body.style.overflow = '';
      // Reset translations éventuelles de drag
      [stageA, stageB].forEach((el) => {
        el.style.transition = 'none';
        el.style.transform = '';
        void el.offsetWidth;
        el.style.transition = '';
      });
      if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
    }

    // ─── Navigation ───────────────────────────────────────────────────────
    function go(delta) {
      if (isAnimating) return;
      const next = (current + delta + total) % total;
      current = next;
      setImage(current, delta > 0 ? 1 : -1);
      updateCounter(current);
      preloadNeighbors(current);
      showChrome();
    }

    function goTo(index) {
      if (isAnimating || index === current) return;
      const direction = index > current ? 1 : -1;
      current = Math.max(0, Math.min(index, total - 1));
      setImage(current, direction);
      updateCounter(current);
      preloadNeighbors(current);
      showChrome();
    }

    // ─── Bindings ─────────────────────────────────────────────────────────
    document.querySelectorAll('[data-slideshow-trigger]').forEach((btn) => {
      btn.addEventListener('click', () => {
        open(parseInt(btn.getAttribute('data-image-index') || '0', 10));
      });
    });

    closeBtn && closeBtn.addEventListener('click', close);
    prevBtn && prevBtn.addEventListener('click', () => go(-1));
    nextBtn && nextBtn.addEventListener('click', () => go(1));

    // Clic sur le fond (pas sur l'image / pas sur un bouton) → fermer
    overlay.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      if (target.closest('.slideshow__btn')) return;
      if (target.closest('.slideshow__image')) return;
      if (target.closest('.slideshow__topbar')) return;
      close();
    });

    document.addEventListener('keydown', (e) => {
      if (!overlay.classList.contains('slideshow--open')) return;
      switch (e.key) {
        case 'Escape': e.preventDefault(); close(); break;
        case 'ArrowRight': e.preventDefault(); go(1); break;
        case 'ArrowLeft': e.preventDefault(); go(-1); break;
        case 'Home': e.preventDefault(); goTo(0); break;
        case 'End': e.preventDefault(); goTo(total - 1); break;
      }
    });

    // Mouvement souris → réafficher chrome
    overlay.addEventListener('mousemove', showChrome);
    overlay.addEventListener('touchstart', showChrome, { passive: true });

    // ─── Swipe / drag tactile avec follow-finger ──────────────────────────
    let dragStartX = 0;
    let dragStartY = 0;
    let dragging = false;
    let dragDx = 0;

    function getActiveImg() {
      return activeStage === 'a' ? stageA : stageB;
    }

    overlay.addEventListener('touchstart', (e) => {
      if (isAnimating) return;
      dragStartX = e.touches[0].clientX;
      dragStartY = e.touches[0].clientY;
      dragging = false;
      dragDx = 0;
    }, { passive: true });

    overlay.addEventListener('touchmove', (e) => {
      if (isAnimating) return;
      const dx = e.touches[0].clientX - dragStartX;
      const dy = e.touches[0].clientY - dragStartY;
      // On démarre le drag horizontal seulement si on est plus horizontal que vertical
      if (!dragging && Math.abs(dx) > 8 && Math.abs(dx) > Math.abs(dy)) {
        dragging = true;
      }
      if (dragging) {
        dragDx = dx;
        const img = getActiveImg();
        // résistance aux bords + suivi du doigt
        img.style.transition = 'none';
        img.style.transform = `translate(calc(-50% + ${dx * 0.6}px), -50%) scale(0.995)`;
      }
    }, { passive: true });

    overlay.addEventListener('touchend', () => {
      if (!dragging) return;
      dragging = false;
      const img = getActiveImg();
      // restaure transition
      img.style.transition = '';
      img.style.transform = '';
      // Seuil 18% de la largeur viewport pour committer
      const threshold = Math.max(60, window.innerWidth * 0.18);
      if (Math.abs(dragDx) > threshold) {
        go(dragDx < 0 ? 1 : -1);
      }
      dragDx = 0;
    }, { passive: true });

    // Nettoyage View Transitions
    document.addEventListener('astro:before-preparation', () => {
      if (overlay.classList.contains('slideshow--open')) close();
    });
  })();
  </script>
)}

<style is:global>
  /* ──────────────────────────────────────────────────────────────────────
     PAGE PROJET — plein écran sans scroll
     ────────────────────────────────────────────────────────────────────── */
  .project-gallery {
    /* 100dvh : dynamic viewport height — gère la barre d'adresse mobile */
    height: 100vh;
    height: 100dvh;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 3.5vw, 3rem) clamp(1.5rem, 4vw, 4rem) clamp(1.5rem, 3.5vw, 3rem);
    overflow: hidden;
  }

  .project-gallery__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 300;
    /* Beaucoup plus généreux */
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    letter-spacing: 0.035em;
    color: #2A2926;
    margin: 0 0 clamp(1rem, 2.5vh, 2rem);
    line-height: 1;
    flex: 0 0 auto;
  }

  .project-gallery__grid {
    display: flex;
    flex: 1 1 auto;
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
    /* Critique : laisse les enfants flex se contracter dans l'espace disponible */
    min-height: 0;
    justify-content: center;
    align-items: stretch;
  }

  /* Cellule = bouton occupant la hauteur dispo */
  .project-gallery__cell {
    flex: 1 1 0;
    min-width: 0;
    min-height: 0;
    height: 100%;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .project-gallery__cell:focus-visible {
    outline: 2px solid #2A2926;
    outline-offset: 4px;
  }

  /* Image affichée ENTIÈREMENT, pas de crop, contrainte à la hauteur dispo */
  .project-gallery__img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1),
                filter 600ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .project-gallery__cell:hover .project-gallery__img,
  .project-gallery__cell:focus-visible .project-gallery__img {
    transform: scale(1.018);
    filter: brightness(0.97);
  }

  /* Empilement mobile — les deux images l'une sous l'autre, toujours sans scroll */
  @media (max-width: 767px) {
    .project-gallery__grid {
      flex-direction: column;
    }
    .project-gallery__title {
      font-size: clamp(2rem, 9vw, 3rem);
      margin-bottom: clamp(0.75rem, 2vh, 1.25rem);
    }
  }

  /* ──────────────────────────────────────────────────────────────────────
     DIAPORAMA IMMERSIF
     Fond doux warm off-white assorti au site. Plein écran. UI minimaliste.
     ────────────────────────────────────────────────────────────────────── */
  .slideshow {
    position: fixed;
    inset: 0;
    z-index: 1000;
    /* Fond doux warm — chaude variation autour de l'ivoire du site */
    background: #ECE6DC;
    /* Vignette très subtile pour donner de la profondeur sans agressivité */
    background-image:
      radial-gradient(ellipse at center, transparent 55%, rgba(40, 32, 24, 0.06) 100%),
      linear-gradient(180deg, #EFE9DF 0%, #E7E1D5 100%);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 380ms cubic-bezier(0.22, 1, 0.36, 1),
                visibility 0s linear 380ms;
  }

  .slideshow--open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 380ms cubic-bezier(0.22, 1, 0.36, 1),
                visibility 0s linear 0s;
  }

  /* Stage — deux <img> empilées en absolu, centrées */
  .slideshow__stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .slideshow__image {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.995);
    /* Vraiment plein écran : marge très réduite sur les côtés */
    max-width: 96vw;
    max-height: 92dvh;
    max-height: 92vh; /* fallback */
    width: auto;
    height: auto;
    object-fit: contain;
    opacity: 0;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
    /* Drop shadow très discret pour ancrer l'image sur le fond clair */
    filter: drop-shadow(0 20px 40px rgba(40, 32, 24, 0.12))
            drop-shadow(0 4px 12px rgba(40, 32, 24, 0.06));
    transition: opacity 520ms cubic-bezier(0.32, 0.72, 0, 1),
                transform 620ms cubic-bezier(0.32, 0.72, 0, 1);
    will-change: transform, opacity;
  }

  .slideshow__image--active {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
    pointer-events: auto;
  }

  /* ── Top bar minimaliste ─────────────────────────────────────────────── */
  .slideshow__topbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: clamp(1rem, 2.5vw, 1.75rem) clamp(1rem, 2.5vw, 2rem);
    pointer-events: none;
    transition: opacity 380ms ease, transform 380ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .slideshow__topbar > * {
    pointer-events: auto;
  }

  .slideshow__counter {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.6875rem;
    letter-spacing: 0.3em;
    color: rgba(42, 41, 38, 0.55);
    font-variant-numeric: tabular-nums;
    text-transform: uppercase;
    user-select: none;
  }

  /* ── Boutons (anthracite sur fond clair) ────────────────────────────── */
  .slideshow__btn {
    appearance: none;
    background: rgba(42, 41, 38, 0.04);
    border: 1px solid rgba(42, 41, 38, 0.08);
    border-radius: 999px;
    color: rgba(42, 41, 38, 0.78);
    padding: 0;
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transition: background 280ms ease, border-color 280ms ease, color 280ms ease, transform 320ms cubic-bezier(0.22, 1, 0.36, 1), opacity 380ms ease;
  }

  .slideshow__btn:hover,
  .slideshow__btn:focus-visible {
    background: rgba(42, 41, 38, 0.08);
    border-color: rgba(42, 41, 38, 0.18);
    color: #2A2926;
    outline: none;
  }

  .slideshow__btn:focus-visible {
    box-shadow: 0 0 0 2px #ECE6DC, 0 0 0 4px rgba(42, 41, 38, 0.35);
  }

  .slideshow__btn:active {
    transform: scale(0.94);
  }

  .slideshow__btn--prev,
  .slideshow__btn--next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    width: 52px;
    height: 52px;
    transition: background 280ms ease, border-color 280ms ease, color 280ms ease, opacity 380ms ease, transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .slideshow__btn--prev { left: clamp(0.75rem, 2vw, 1.75rem); }
  .slideshow__btn--next { right: clamp(0.75rem, 2vw, 1.75rem); }

  .slideshow__btn--prev:hover { transform: translateY(-50%) translateX(-2px); }
  .slideshow__btn--next:hover { transform: translateY(-50%) translateX(2px); }
  .slideshow__btn--prev:active { transform: translateY(-50%) scale(0.94); }
  .slideshow__btn--next:active { transform: translateY(-50%) scale(0.94); }

  .slideshow__icon { width: 16px; height: 16px; }
  .slideshow__icon-lg { width: 22px; height: 22px; }

  /* ── Chrome auto-hide ─────────────────────────────────────────────────
     Quand `data-chrome="hidden"`, le compteur, le bouton fermer et les
     flèches s'estompent doucement à 25 % d'opacité — toujours accessibles
     mais pas intrusifs. Le moindre mouvement souris / touch les rappelle. */
  .slideshow[data-chrome="hidden"] .slideshow__topbar,
  .slideshow[data-chrome="hidden"] .slideshow__btn--prev,
  .slideshow[data-chrome="hidden"] .slideshow__btn--next {
    opacity: 0.2;
  }
  .slideshow[data-chrome="hidden"] .slideshow__btn--prev:hover,
  .slideshow[data-chrome="hidden"] .slideshow__btn--next:hover,
  .slideshow[data-chrome="hidden"] .slideshow__topbar:hover {
    opacity: 1;
  }

  /* ── Mobile : flèches plus petites ────────────────────────────────── */
  @media (max-width: 640px) {
    .slideshow__btn--prev,
    .slideshow__btn--next {
      width: 40px;
      height: 40px;
    }
    .slideshow__image {
