---
import { getDict, getProjectUrl } from '@/i18n';
import type { Locale } from '@/i18n';
import type { SiteProject } from '@/lib/projects';
import { getLocalized, getProjectMetaLine, getProjectSlug } from '@/lib/projects';
import { CARD_WIDTHS, buildImageSrcSet, resolveImageUrl } from '@/lib/sanity';

interface Props {
  projects: SiteProject[];
  lang: Locale;
}

const { projects, lang } = Astro.props;
const t = getDict(lang);

/**
 * Format des vignettes — identique à l'`aspect-ratio` de `.project-card__img-wrap`.
 * Les images sont recadrées à ce format côté CDN : le navigateur ne télécharge
 * plus les pixels que le `object-fit: cover` allait de toute façon rogner.
 */
const CARD_RATIO = 1.5; // 2:3

/**
 * Deux colonnes sous 768 px, trois au-delà, dans un conteneur à marges de
 * 40 px (64 px en lg). Les valeurs ci-dessous sont volontairement un peu
 * généreuses : mieux vaut une vignette légèrement trop fine que floue.
 */
const CARD_SIZES = '(min-width: 1024px) 30vw, (min-width: 768px) 31vw, 45vw';

/** Dimensions intrinsèques déclarées sur le <img> — réservent la place, CLS nul. */
const CARD_W = 480;
const CARD_H = Math.round(CARD_W * CARD_RATIO);
---

<ul
  class="grid grid-cols-2 md:grid-cols-3 gap-x-6 gap-y-12"
  role="list"
  aria-label={t.projects.title}
>
  {projects.map((project, idx) => {
    const slug = getProjectSlug(project, lang);
    const title = getLocalized(project.title, lang);
    const metaLine = getProjectMetaLine(project, lang);

    // Première image preview, sinon première image de la galerie
    const previewImg =
      project.gallery.find((img) => img.isPreview) ?? project.gallery[0] ?? null;
    const imgSrc = previewImg
      ? (resolveImageUrl(previewImg, CARD_W, CARD_H) ?? '')
      : '';
    const imgAlt = previewImg?.alt ? getLocalized(previewImg.alt, lang) : title;

    // Jeu de largeurs — nul pour une image locale : on sert alors le <img> seul.
    const srcSet = buildImageSrcSet(previewImg, CARD_WIDTHS, CARD_RATIO);

    // Les deux premières cartes sont au-dessus de la ligne de flottaison sur
    // tous les formats : elles portent le LCP et ne doivent pas être différées.
    const isAboveFold = idx < 2;

    return (
      <li>
        <a
          href={getProjectUrl(lang, slug)}
          class="project-card group block"
          aria-label={`${t.projects.viewProject} : ${title}`}
        >
          {/* Image preview */}
          <div class="project-card__img-wrap">
            {imgSrc ? (
              <img
                src={imgSrc}
                srcset={srcSet ?? undefined}
                sizes={srcSet ? CARD_SIZES : undefined}
                alt={imgAlt}
                width={CARD_W}
                height={CARD_H}
                class="project-card__img"
                loading={isAboveFold ? 'eager' : 'lazy'}
                fetchpriority={isAboveFold ? 'high' : 'auto'}
                decoding="async"
              />
            ) : (
              <div class="project-card__img-placeholder" aria-hidden="true" />
            )}
          </div>

          {/* Titre + méta */}
          <p class="project-card__title font-sans text-xs tracking-[0.2em] text-anthracite-300 uppercase group-hover:text-anthracite-500 transition-colors duration-400 mt-3 mb-1">
            {title}
          </p>
          {metaLine && (
            <p class="font-sans text-xs text-greige-400 tracking-wide">
              {metaLine}
            </p>
          )}
        </a>
      </li>
    );
  })}
</ul>

<style is:global>
  /* ── Carte projet ────────────────────────────────────────────────────── */
  .project-card__img-wrap {
    overflow: hidden;
    aspect-ratio: 2 / 3;
    background: #EDE9E3;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .project-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    filter: saturate(0.92);
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1),
                filter 600ms ease;
  }

  .project-card:hover .project-card__img,
  .project-card:focus-visible .project-card__img {
    transform: scale(1.03);
    filter: saturate(1);
  }

  .project-card__img-placeholder {
    width: 100%;
    height: 100%;
    background: #EDE9E3;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card__img {
      transition: none !important;
    }
    .project-card:hover .project-card__img {
      transform: none !important;
    }
  }
</style>
