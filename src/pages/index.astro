---
/**
 * Landing page FR — /
 *
 * Tous écrans : slideshow plein écran, crossfade, Ken Burns.
 *   4 images défilent en séquence automatique.
 *   Dots de navigation visibles sur mobile, masqués sur desktop.
 *
 * Principes communs :
 *  — Première image visible IMMÉDIATEMENT : preload + reveal SSR.
 *  — Fond de page : ivoire (jamais noir entre les slides).
 *  — prefers-reduced-motion : Ken Burns et crossfade désactivés.
 */
import LandingLayout from '@/layouts/LandingLayout.astro';
import { getDict } from '@/i18n';

const t = getDict('fr');

/**
 * Une diapositive de la landing.
 *
 * `mobileSrc` permet d'afficher une autre photo sous 768 px sans toucher à
 * l'ordre du diaporama : en portrait, le recadrage « cover » remonte le sujet
 * dans l'angle haut-gauche, là où se trouve le nom « Marion Dériot ». Les deux
 * premières images sont donc permutées sur mobile pour préserver le contraste
 * du titre, tout en gardant l'ordre voulu sur desktop.
 */
type LandingImage = {
  src: string;
  alt: string;
  mobileSrc?: string;
  fit?: 'cover' | 'contain';
};

const images: LandingImage[] = [
  {
    src: '/images/landing/01-cuisine-verte.webp',
    mobileSrc: '/images/landing/02-lavoisier.webp',
    alt: 'Cuisine sur mesure — îlot central, lustre rouge, Agence Marion Dériot architecte d\'intérieur',
  },
  {
    src: '/images/landing/02-lavoisier.webp',
    mobileSrc: '/images/landing/01-cuisine-verte.webp',
    alt: 'Lavoisier — réalisation Agence Marion Dériot architecte d\'intérieur',
  },
  {
    src: '/images/projets/BOURDONNAIS/0_0008.webp',
    alt: 'Bourdonnais — intérieur, lumière et matières, Agence Marion Dériot architecte d\'intérieur, Paris 7ème',
  },
  {
    src: '/images/landing/04-mignet.webp',
    alt: 'Mignet — conception Marion Dériot, Paris',
  },
];
---

<LandingLayout
  title={t.home.title}
  description={t.home.metaDescription}
  lang="fr"
>
  <!-- Préchargement : toutes les images sont au-dessus du fold sur desktop -->
  <Fragment slot="head">
    {/* Les deux premières sont candidates au LCP : l'une sur desktop, l'autre sur mobile. */}
    <link rel="preload" as="image" href={images[0].src} fetchpriority="high" />
    <link rel="preload" as="image" href={images[0].mobileSrc ?? images[1].src} fetchpriority="high" />
    {images.slice(2).map((img) => (
      <link rel="preload" as="image" href={img.src} fetchpriority="low" />
    ))}
    <script is:inline define:vars={{ firstSlideSrc: images[0].src }}>
      (function revealLanding(src) {
        function ready() {
          document.documentElement.classList.remove('landing-pending');
          document.documentElement.classList.add('landing-ready');
        }
        const img = new Image();
        img.onload = ready;
        img.onerror = ready;
        img.src = src;
        if (img.complete) ready();
        setTimeout(ready, 5000);
      })(firstSlideSrc);
    </script>
  </Fragment>

  <div class="landing-root" id="landing-root">

    <!-- ── Slideshow — tous écrans ─────────────────────────────────────── -->
    <div class="slides-container" id="slides-container" aria-hidden="true">
      {images.map((img, i) => (
        <div
          class={`slide${i === 0 ? ' slide--on' : ''}${img.fit === 'contain' ? ' slide--contain' : ''}`}
          data-index={i}
          style={`--slide-desktop: url('${img.src}'); --slide-mobile: url('${img.mobileSrc ?? img.src}')`}
          role="img"
          aria-label={img.alt}
        />
      ))}
    </div>

    <!-- ── Gradient localisé top-left (lisibilité du nom) ────────────────── -->
    <div class="landing-title-gradient landing-chrome" aria-hidden="true" />

    <!-- ── Identité — carte givrée ───────────────────────────────────────── -->
    <header class="landing-identity landing-chrome" id="landing-identity">
      <h1 class="landing-name">Marion Dériot</h1>
      <p class="landing-tagline">{t.landing.tagline}</p>
    </header>

    <!-- ── Contrôles (dots mobile + bouton Entrer) ───────────────────────── -->
    <div class="landing-controls landing-chrome" id="landing-controls">
      <!-- Dots : visibles uniquement sur mobile -->
      <div class="slide-indicators" role="tablist" aria-label="Diaporama">
        {images.map((_, i) => (
          <button
            type="button"
            role="tab"
            class={`slide-dot${i === 0 ? ' slide-dot--active' : ''}`}
            data-target={i}
            aria-label={`Image ${i + 1}`}
            aria-selected={i === 0 ? 'true' : 'false'}
          />
        ))}
      </div>

      <button
        type="button"
        id="landing-enter-btn"
        class="landing-enter"
        aria-label={t.landing.enterLabel}
      >
        <span class="enter-label">{t.landing.enter}</span>
      </button>
    </div>

  </div>

  <!-- Voile ivoire pour la transition vers /home -->
  <div class="enter-veil" id="enter-veil" aria-hidden="true"></div>
</LandingLayout>

<!-- ─── Styles ───────────────────────────────────────────────────────────── -->
<style is:global>
  /* ── Racine landing ─────────────────────────────────────────────────────── */
  .landing-root {
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: transparent;
  }

  /* ══════════════════════════════════════════════════════════════════════════
     SLIDESHOW — tous écrans
     Masquer les dots sur desktop (inutiles sans touch).
  ══════════════════════════════════════════════════════════════════════════ */
  @media (min-width: 1024px) {
    .slide-indicators {
      display: none;
    }
  }

  /* Reveal slideshow : masqué pendant landing-pending, fondu à landing-ready */
  html.landing-pending .slide--on {
    opacity: 0;
  }
  html.landing-ready .slide--on {
    opacity: 1;
    animation: kenBurns 18s cubic-bezier(0.33, 0, 0.67, 1) forwards;
  }

  /* ══════════════════════════════════════════════════════════════════════════
     SLIDES — tous écrans
  ══════════════════════════════════════════════════════════════════════════ */
  .slides-container {
    position: absolute;
    inset: 0;
  }

  .slide {
    position: absolute;
    inset: 0;
    background-image: var(--slide-desktop);
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    transform-origin: center center;
    opacity: 0;
    z-index: 0;
    will-change: transform, opacity;
  }

  /* Images verticales / basse résolution : affichées en entier, jamais zoomées,
     encadrées sur l'ivoire (évite l'agrandissement flou du cover). */
  .slide--contain {
    background-size: contain;
    background-color: #F5F3EF;
  }

  .slide--on {
    opacity: 1;
    z-index: 1;
    animation: kenBurns 18s cubic-bezier(0.33, 0, 0.67, 1) forwards;
  }

  .slide--on.slide--kb-reverse {
    animation-name: kenBurnsReverse;
  }

  @keyframes kenBurns {
    from { transform: scale(1.00) translate(0%,    0%);    }
    to   { transform: scale(1.04) translate(-0.6%, -0.3%); }
  }

  @keyframes kenBurnsReverse {
    from { transform: scale(1.00) translate(0%,    0%);   }
    to   { transform: scale(1.04) translate( 0.6%, 0.3%); }
  }

  /* ── Mobile : cadrage des images, notamment en format horizontal ────────── */
  /* En portrait, une image paysage en "cover" est déjà fortement recadrée :
     on supprime le zoom Ken Burns pour ne pas l'agrandir davantage, et on
     centre le cadrage. Le défilement automatique reste inchangé. */
  @media (max-width: 767px) {
    .slide {
      background-image: var(--slide-mobile);
      background-size: cover;
      background-position: center center;
    }
    html.landing-ready .slide--on,
    .slide--on,
    .slide--on.slide--kb-reverse {
      animation: none !important;
      transform: none !important;
    }
  }

  /* ── Gradient localisé top-left — retiré, remplacé par carte givrée ────── */
  .landing-title-gradient {
    display: none;
  }

  /* ── Identité — texte noir sans cadre ─────────────────────────────────────── */
  .landing-identity {
    position: absolute;
    top: clamp(1.75rem, 3.5vw, 3rem);
    left: clamp(1.75rem, 3.5vw, 3rem);
    z-index: 10;
    text-align: left;
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 900ms cubic-bezier(0.25, 0.46, 0.45, 0.94),
      transform 900ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    padding: 0;
    border-radius: 0;
    box-shadow: none;
  }

  /* Lockup : tagline en espacement standard, calibrée pour couvrir
     à peu près la largeur de « Marion Dériot » (sans étirement). */
  .landing-identity {
    width: max-content;
  }

  .landing-name {
    font-family: 'Cormorant Garamond', Georgia, serif;
    /* 3rem max — même longueur visuelle que la tagline en dessous */
    font-size: clamp(1.875rem, 4vw, 3rem);
    font-weight: 600;
    color: #111110;
    letter-spacing: 0.04em;
    line-height: 1.1;
    margin: 0 0 0.7rem;
    white-space: nowrap;
  }

  .landing-tagline {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: clamp(0.7rem, 1.28vw, 0.96rem);
    font-weight: 400;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #6B6A68;
    margin: 0;
    line-height: 1.4;
    white-space: nowrap;
  }

  /* ── Contrôles bas-centré (dots + bouton Entrer) ─────────────────────────── */
  .landing-controls {
    position: absolute;
    bottom: clamp(1.75rem, 3.5vw, 2.75rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  /* ── Bouton "Entrer" — encadrement noir ──────────────────────────────────── */
  .landing-enter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border: 1px solid #111110;
    cursor: pointer;
    padding: 0.7rem 2.2rem;
    border-radius: 0;
    box-shadow: none;
    transition:
      background 400ms ease,
      border-color 400ms ease,
      box-shadow 400ms ease;
  }

  .landing-enter:hover,
  .landing-enter:focus-visible {
    background: rgba(17, 17, 16, 0.05);
    box-shadow: none;
    outline: none;
  }

  .enter-label {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #111110;
    font-weight: 500;
  }

  /* ── Indicateurs de slide (mobile uniquement) ────────────────────────────── */
  .slide-indicators {
    display: flex;
    gap: 0.5rem;
    opacity: 1;
    transition: opacity 700ms ease;
  }

  .slide-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(245, 243, 239, 0.4);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 400ms ease, transform 300ms ease;
  }

  .slide-dot--active {
    background: rgba(245, 243, 239, 0.95);
    transform: scale(1.4);
  }

  .slide-dot:hover:not(.slide-dot--active) {
    background: rgba(245, 243, 239, 0.7);
  }

  /* ── Voile ivoire — transition vers /home ────────────────────────────────── */
  .enter-veil {
    position: fixed;
    inset: 0;
    z-index: 999;
    background: #F5F3EF;
    opacity: 0;
    pointer-events: none;
    transition: opacity 650ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .enter-veil.active {
    opacity: 1;
    pointer-events: all;
  }

  /* ── prefers-reduced-motion ──────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .slide--on,
    .landing-identity,
    .landing-enter,
    .slide-indicators,
    .slide-dot,
    .enter-label,
    .enter-veil {
      animation: none !important;
      transition: none !important;
      transform: none !important;
    }

    /* Slideshow : image visible immédiatement */
    html.landing-pending .slide--on,
    html.landing-ready  .slide--on { opacity: 1 !important; }

    .slide      { opacity: 0 !important; }
    .slide--on  { opacity: 1 !important; }
    .landing-identity { transform: translate(0, 0) !important; }
    .landing-controls { transform: translateX(-50%) !important; }
  }
</style>

<!-- ─── Script slideshow (mobile) + transition "entrée" ─────────────────── -->
<script>
  // ── Références DOM ──────────────────────────────────────────────────────────
  const slides    = Array.from(document.querySelectorAll<HTMLElement>('.slide'));
  const dots      = Array.from(document.querySelectorAll<HTMLButtonElement>('.slide-dot'));
  const enterBtn  = document.getElementById('landing-enter-btn')  as HTMLButtonElement;
  const enterVeil = document.getElementById('enter-veil')         as HTMLElement;

  // ── Constantes timing ───────────────────────────────────────────────────────
  const INTERVAL  = 5000;
  const FADE_MS   = 1600;
  const KB_REVERSE = 'slide--kb-reverse';

  let current = 0;
  let timer: ReturnType<typeof setInterval> | null = null;
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function resetKB(el: HTMLElement) {
    el.style.animation = 'none';
    void el.offsetHeight;
    el.style.removeProperty('animation');
  }

  function clearSlideRuntimeStyles(el: HTMLElement) {
    el.style.removeProperty('z-index');
    el.style.removeProperty('opacity');
    el.style.removeProperty('transition');
    el.style.removeProperty('transform');
    el.style.removeProperty('animation');
  }

  function updateDots(index: number) {
    dots.forEach((dot, i) => {
      const active = i === index;
      dot.classList.toggle('slide-dot--active', active);
      dot.setAttribute('aria-selected', active ? 'true' : 'false');
    });
  }

  // ── Changement de slide — crossfade garanti zéro fond visible ──────────────
  function goTo(index: number) {
    if (index === current) return;

    const oldEl = slides[current];
    const newEl = slides[index];

    if (prefersReduced) {
      clearSlideRuntimeStyles(oldEl);
      oldEl.classList.remove('slide--on', KB_REVERSE);
      clearSlideRuntimeStyles(newEl);
      newEl.classList.remove(KB_REVERSE);
      newEl.classList.add('slide--on');
      current = index;
      updateDots(index);
      return;
    }

    updateDots(index);
    current = index;

    clearSlideRuntimeStyles(newEl);
    newEl.classList.remove('slide--on', KB_REVERSE);
    resetKB(newEl);
    newEl.classList.toggle(KB_REVERSE, index % 2 === 1);
    newEl.classList.add('slide--on');

    const frozenT = window.getComputedStyle(oldEl).transform;
    oldEl.classList.remove('slide--on');
    if (frozenT && frozenT !== 'none') {
      oldEl.style.transform = frozenT;
    }
    oldEl.style.zIndex     = '2';
    oldEl.style.opacity    = '1';
    oldEl.style.transition = '';

    void oldEl.offsetHeight;

    oldEl.style.transition = `opacity ${FADE_MS}ms cubic-bezier(0.4, 0, 0.6, 1)`;
    oldEl.style.opacity    = '0';

    setTimeout(() => {
      clearSlideRuntimeStyles(oldEl);
      oldEl.classList.remove(KB_REVERSE);
    }, FADE_MS + 150);
  }

  function goNext() {
    goTo((current + 1) % slides.length);
  }

  // ── Autoplay (mobile slideshow uniquement) ──────────────────────────────────
  if (slides.length > 1) {
    timer = setInterval(goNext, INTERVAL);
  }

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      if (i === current) return;
      if (timer) { clearInterval(timer); timer = null; }
      goTo(i);
      timer = setInterval(goNext, INTERVAL);
    });
  });

  document.addEventListener('astro:before-preparation', () => {
    if (timer) clearInterval(timer);
  });

  // ── Transition "entrée" — fondu vers l'ivoire ─────────────────────────────
  enterBtn?.addEventListener('click', () => {
    if (prefersReduced) {
      window.location.href = '/home';
      return;
    }

    enterBtn.disabled = true;
    if (timer) clearInterval(timer);

    enterVeil?.classList.add('active');

    setTimeout(() => {
      window.location.href = '/home';
    }, 580);
  });

  enterBtn?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      enterBtn.click();
    }
  });
</script>
