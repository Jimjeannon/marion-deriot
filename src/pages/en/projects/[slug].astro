---
/**
 * Page projet individuel EN — /en/projects/[slug]
 *
 * Layout v1 :
 *  - Title at top
 *  - 2 preview images side by side
 *  - Click on either → immersive slideshow over the entire gallery
 */
import MainLayout from '@/layouts/MainLayout.astro';
import ProjectGallery from '@/components/sections/ProjectGallery.astro';
import { getAllProjects, getLocalized } from '@/lib/projects';

export async function getStaticPaths() {
  const projects = await getAllProjects();
  return projects.map((project) => ({
    params: { slug: project.slug.en.current },
    props: { project },
  }));
}

interface Props {
  project: import('@/lib/projects').SiteProject;
}

const { project } = Astro.props;
const pageTitle = project.seo?.title?.en ?? `${project.title.en} — Marion Dériot`;
const pageDescription = project.seo?.description?.en ?? getLocalized(project.description, 'en');
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  lang="en"
  activeNav="projects"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    'name': project.title.en,
    'description': getLocalized(project.description, 'en'),
    'creator': { '@type': 'Person', 'name': 'Marion Dériot' },
    'dateCreated': project.year?.toString(),
    'genre': project.category,
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': [
      { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://marionderiot.com/en/home' },
      { '@type': 'ListItem', 'position': 2, 'name': 'Projects', 'item': 'https://marionderiot.com/en/projects' },
      { '@type': 'ListItem', 'position': 3, 'name': project.title.en, 'item': `https://marionderiot.com/en/projects/${project.slug.en.current}` },
    ],
  })} />

  <ProjectGallery project={project} lang="en" />
</MainLayout>
