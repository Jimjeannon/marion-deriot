---
import MainLayout from '@/layouts/MainLayout.astro';
import { getDict } from '@/i18n';

const t = getDict('en');
---

<MainLayout
  title={t.info.metaTitle}
  description={t.info.metaDescription}
  lang="en"
  activeNav="info"
>
  <div class="px-10 py-16 lg:px-16 max-w-2xl">
    <h1 class="font-serif text-4xl font-light text-anthracite-300 mb-16">
      {t.info.title}
    </h1>

    <div class="mb-16">
      <div class="w-48 h-60 bg-greige-100 mb-10" aria-hidden="true"></div>
      <div class="space-y-5 font-sans text-sm text-anthracite-300 leading-relaxed">
        <p>
          A graduate of École Camondo in 1999, Marion Dériot has practised interior architecture
          and design for over twenty-five years. She collaborated with Wilmotte & Associés,
          Bruno Moinard and Agence Ecart before founding her own studio in 2009.
        </p>
        <p>
          Her approach is rooted in careful listening, precision in detail and a considered
          selection of materials. Each project is bespoke — designed to last, for discerning
          private clients and professionals with high standards for their spaces.
        </p>
        <p>
          The studio is based in Boulogne-Billancourt and works primarily in Paris
          and Île-de-France.
        </p>
      </div>
    </div>

    <div class="mb-16 space-y-2 font-sans text-sm text-greige-400">
      <address class="not-italic space-y-1">
        <p>Marion Dériot Studio</p>
        <p>Boulogne-Billancourt — 92100, France</p>
        <p>
          <a href="mailto:marionderiot.archi@gmail.com" class="hover:text-anthracite-300 transition-colors duration-400">
            marionderiot.archi@gmail.com
          </a>
        </p>
      </address>
    </div>

    <section aria-labelledby="contact-title-en">
      <h2 id="contact-title-en" class="font-serif text-2xl font-light text-anthracite-300 mb-8">
        {t.info.contactTitle}
      </h2>
      <form method="POST" action="/api/contact" class="space-y-6" novalidate>
        <div>
          <label for="name-en" class="block font-sans text-xs tracking-wide text-greige-400 mb-2">
            {t.info.form.name} <span class="text-accent ml-1" aria-hidden="true">*</span>
          </label>
          <input type="text" id="name-en" name="name" required autocomplete="name"
            class="w-full border-b border-greige-200 bg-transparent py-2 font-sans text-sm text-anthracite-300 focus:border-anthracite-300 focus:outline-none transition-colors duration-400" />
        </div>
        <div>
          <label for="email-en" class="block font-sans text-xs tracking-wide text-greige-400 mb-2">
            {t.info.form.email} <span class="text-accent ml-1" aria-hidden="true">*</span>
          </label>
          <input type="email" id="email-en" name="email" required autocomplete="email"
            class="w-full border-b border-greige-200 bg-transparent py-2 font-sans text-sm text-anthracite-300 focus:border-anthracite-300 focus:outline-none transition-colors duration-400" />
        </div>
        <div>
          <label for="message-en" class="block font-sans text-xs tracking-wide text-greige-400 mb-2">
            {t.info.form.message} <span class="text-accent ml-1" aria-hidden="true">*</span>
          </label>
          <textarea id="message-en" name="message" required rows={5} placeholder={t.info.form.messagePlaceholder}
            class="w-full border-b border-greige-200 bg-transparent py-2 font-sans text-sm text-anthracite-300 placeholder-greige-300 focus:border-anthracite-300 focus:outline-none transition-colors duration-400 resize-none"></textarea>
        </div>
        <input type="hidden" name="lang" value="en" />
        <button type="submit"
          class="font-sans text-xs tracking-[0.2em] uppercase text-anthracite-300 border-b border-anthracite-300 pb-0.5 hover:text-accent hover:border-accent transition-colors duration-400">
          {t.info.form.submit}
        </button>
      </form>
    </section>
  </div>
</MainLayout>
