---
/**
 * Landing page EN — /en/
 * Mirror de la landing FR avec les mêmes images et le même triptique.
 */
import LandingLayout from '@/layouts/LandingLayout.astro';
import { getDict } from '@/i18n';

const t = getDict('en');

const images = [
  {
    src: '/images/acceuil/8.jpg',
    alt: 'Custom interior — Marion Dériot, interior architect',
  },
  {
    src: '/images/acceuil/14.jpg',
    alt: 'Interior architecture — design and realisation, Marion Dériot, Paris',
  },
  {
    src: '/images/acceuil/17.jpg',
    alt: 'Interior design detail — craftsmanship, Agence Marion Dériot',
  },
];
---

<LandingLayout
  title={t.home.title}
  description={t.home.metaDescription}
  lang="en"
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={images[0].src} fetchpriority="high" />
    <link rel="preload" as="image" href={images[1].src} fetchpriority="low" />
    <link rel="preload" as="image" href={images[2].src} fetchpriority="low" />
    <script is:inline define:vars={{ firstSlideSrc: images[0].src }}>
      (function revealLanding(src) {
        function ready() {
          document.documentElement.classList.remove('landing-pending');
          document.documentElement.classList.add('landing-ready');
        }
        const img = new Image();
        img.onload = ready;
        img.onerror = ready;
        img.src = src;
        if (img.complete) ready();
        setTimeout(ready, 5000);
      })(firstSlideSrc);
    </script>
  </Fragment>

  <div class="landing-root" id="landing-root">

    <!-- ── Triptique — desktop ≥ 1024px ─────────────────────────────────── -->
    <div class="triptych" aria-hidden="true">
      {images.map((img, i) => (
        <div class={`triptych-panel triptych-panel--${i + 1}`}>
          <div class="panel-bg" style={`background-image: url('${img.src}')`} />
        </div>
      ))}
    </div>

    <!-- ── Slideshow — mobile < 1024px ──────────────────────────────────── -->
    <div class="slides-container" id="slides-container" aria-hidden="true">
      {images.map((img, i) => (
        <div
          class={`slide${i === 0 ? ' slide--on' : ''}`}
          data-index={i}
          style={`background-image: url('${img.src}')`}
          role="img"
          aria-label={img.alt}
        />
      ))}
    </div>

    <div class="landing-title-gradient landing-chrome" aria-hidden="true" />

    <header class="landing-identity landing-chrome" id="landing-identity">
      <h1 class="landing-name">Marion Dériot</h1>
      <p class="landing-tagline">{t.landing.tagline}</p>
    </header>

    <div class="landing-controls landing-chrome" id="landing-controls">
      <div class="slide-indicators" role="tablist" aria-label="Slideshow">
        {images.map((_, i) => (
          <button
            type="button"
            role="tab"
            class={`slide-dot${i === 0 ? ' slide-dot--active' : ''}`}
            data-target={i}
            aria-label={`Image ${i + 1}`}
            aria-selected={i === 0 ? 'true' : 'false'}
          />
        ))}
      </div>

      <button
        type="button"
        id="landing-enter-btn"
        class="landing-enter"
        aria-label={t.landing.enterLabel}
      >
        <span class="enter-label">{t.landing.enter}</span>
      </button>
    </div>

  </div>

  <div class="enter-veil" id="enter-veil" aria-hidden="true"></div>
</LandingLayout>

<script>
  const slides    = Array.from(document.querySelectorAll<HTMLElement>('.slide'));
  const dots      = Array.from(document.querySelectorAll<HTMLButtonElement>('.slide-dot'));
  const enterBtn  = document.getElementById('landing-enter-btn')  as HTMLButtonElement;
  const enterVeil = document.getElementById('enter-veil')         as HTMLElement;

  const INTERVAL  = 5500;
  const FADE_MS   = 1600;
  const KB_REVERSE = 'slide--kb-reverse';

  let current = 0;
  let timer: ReturnType<typeof setInterval> | null = null;
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function resetKB(el: HTMLElement) {
    el.style.animation = 'none';
    void el.offsetHeight;
    el.style.removeProperty('animation');
  }

  function clearSlideRuntimeStyles(el: HTMLElement) {
    el.style.removeProperty('z-index');
    el.style.removeProperty('opacity');
    el.style.removeProperty('transition');
    el.style.removeProperty('transform');
    el.style.removeProperty('animation');
  }

  function updateDots(index: number) {
    dots.forEach((dot, i) => {
      const active = i === index;
      dot.classList.toggle('slide-dot--active', active);
      dot.setAttribute('aria-selected', active ? 'true' : 'false');
    });
  }

  function goTo(index: number) {
    if (index === current) return;
    const oldEl = slides[current];
    const newEl = slides[index];

    if (prefersReduced) {
      clearSlideRuntimeStyles(oldEl);
      oldEl.classList.remove('slide--on', KB_REVERSE);
      clearSlideRuntimeStyles(newEl);
      newEl.classList.remove(KB_REVERSE);
      newEl.classList.add('slide--on');
      current = index;
      updateDots(index);
      return;
    }

    updateDots(index);
    current = index;

    clearSlideRuntimeStyles(newEl);
    newEl.classList.remove('slide--on', KB_REVERSE);
    resetKB(newEl);
    newEl.classList.toggle(KB_REVERSE, index % 2 === 1);
    newEl.classList.add('slide--on');

    const frozenT = window.getComputedStyle(oldEl).transform;
    oldEl.classList.remove('slide--on');
    if (frozenT && frozenT !== 'none') oldEl.style.transform = frozenT;
    oldEl.style.zIndex     = '2';
    oldEl.style.opacity    = '1';
    oldEl.style.transition = '';
    void oldEl.offsetHeight;
    oldEl.style.transition = `opacity ${FADE_MS}ms cubic-bezier(0.4, 0, 0.6, 1)`;
    oldEl.style.opacity    = '0';

    setTimeout(() => {
      clearSlideRuntimeStyles(oldEl);
      oldEl.classList.remove(KB_REVERSE);
    }, FADE_MS + 150);
  }

  function goNext() { goTo((current + 1) % slides.length); }

  if (slides.length > 1) timer = setInterval(goNext, INTERVAL);

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      if (i === current) return;
      if (timer) { clearInterval(timer); timer = null; }
      goTo(i);
      timer = setInterval(goNext, INTERVAL);
    });
  });

  document.addEventListener('astro:before-preparation', () => {
    if (timer) clearInterval(timer);
  });

  enterBtn?.addEventListener('click', () => {
    if (prefersReduced) { window.location.href = '/en/home'; return; }
    enterBtn.disabled = true;
    if (timer) clearInterval(timer);
    enterVeil?.classList.add('active');
    setTimeout(() => { window.location.href = '/en/home'; }, 580);
  });

  enterBtn?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); enterBtn.click(); }
  });
</script>
