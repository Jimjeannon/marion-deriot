---
/**
 * Page 404 — Not Found
 * Sobre, dans le style du site. Pas de sidebar (pas de layout complet).
 */
import MainLayout from '@/layouts/MainLayout.astro';

/**
 * Rendu à la demande — et non pré-rendu.
 *
 * Deux raisons. D'abord, cette page est la cible du `Astro.rewrite('/404')`
 * des fiches projet : elle doit pouvoir s'exécuter à la volée. Ensuite et
 * surtout, c'est ici qu'on fixe le code de statut : une page introuvable qui
 * répondrait 200 est une « soft 404 », que Google finit par indexer comme une
 * page vide et qui dilue le référencement du reste du site.
 */
export const prerender = false;

Astro.response.status = 404;
Astro.response.headers.set('X-Robots-Tag', 'noindex, follow');
---

<MainLayout
  title="Page introuvable — Marion Dériot"
  description="La page que vous recherchez n'existe pas."
  lang="fr"
>
  <div class="min-h-screen flex flex-col items-center justify-center px-10 text-center">
    <p class="font-serif text-7xl font-light text-greige-200 mb-8" aria-hidden="true">
      404
    </p>
    <h1 class="font-sans text-xs tracking-[0.25em] uppercase text-greige-400 mb-10">
      Page introuvable
    </h1>
    <a
      href="/home"
      class="font-sans text-xs tracking-[0.2em] uppercase text-anthracite-300 border-b border-anthracite-300 pb-0.5 hover:text-accent hover:border-accent transition-colors duration-400"
    >
      Retour à l'accueil
    </a>
  </div>
</MainLayout>
