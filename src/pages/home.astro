---
/**
 * Homepage FR — /home
 * Layout sidebar. Point d'entrée après la landing.
 * Contenu à définir avec Marion — pour l'instant page d'accueil sobre avec intro.
 */
import MainLayout from '@/layouts/MainLayout.astro';
import { getDict } from '@/i18n';
// import { getAllProjects, urlFor, getPreviewImages } from '@/lib/sanity';

const t = getDict('fr');

// TODO: charger projets en vedette depuis Sanity
// const projects = await getAllProjects();
// const featured = projects.slice(0, 3);

const pageTitle = t.home.title;
const pageDescription = t.home.metaDescription;
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  lang="fr"
  activeNav="home"
>
  <!-- Schema.org LocalBusiness -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    'name': 'Agence Marion Dériot',
    'description': pageDescription,
    'url': 'https://marionderiot.com',
    'telephone': '+33686186270',
    'email': 'marionderiot.archi@gmail.com',
    'address': {
      '@type': 'PostalAddress',
      'addressLocality': 'Boulogne-Billancourt',
      'addressRegion': 'Île-de-France',
      'addressCountry': 'FR',
    },
    'geo': {
      '@type': 'GeoCoordinates',
      'latitude': 48.8396,
      'longitude': 2.2297,
    },
    'areaServed': [
      { '@type': 'City', 'name': 'Boulogne-Billancourt' },
      { '@type': 'City', 'name': 'Paris' },
      { '@type': 'State', 'name': 'Île-de-France' },
    ],
    'priceRange': '€€€',
    'sameAs': [
      'https://www.instagram.com/marionderiot',
      'https://www.linkedin.com/in/marionderiot',
    ],
  })} />

  <div class="home-content">
    <!-- H1 unique de la page -->
    <h1 class="sr-only">{pageTitle}</h1>

    <!-- ─── Images plein écran ───────────────────────────────────────────── -->
    <section class="home-materials" aria-label="Réalisations Marion Dériot">
      <div class="home-materials__grid">
        <div class="home-materials__cell home-materials__cell--wide">
          <img
            src="/images/acceuil/8.jpg"
            alt="Intérieur sur mesure — réalisation Agence Marion Dériot, architecte d'intérieur"
            class="home-materials__img"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="home-materials__cell">
          <img
            src="/images/acceuil/14.jpg"
            alt="Architecture intérieure — conception et détail de savoir-faire, Marion Dériot"
            class="home-materials__img"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="home-materials__cell">
          <img
            src="/images/acceuil/17.jpg"
            alt="Aménagement intérieur — assemblage de matériaux, Agence Marion Dériot Paris"
            class="home-materials__img"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>
  </div>

  <style is:global>
    /* ── Home plein écran — pas de scroll ───────────────────────────────── */
    .home-content {
      height: 100vh;
      height: 100dvh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      padding: 0;
    }

    .home-materials {
      flex: 1 1 0;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }

    /* ── Grille 3 images ─────────────────────────────────────────────────── */
    .home-materials__grid {
      flex: 1 1 0;
      min-height: 0;
      display: grid;
      grid-template-columns: 1.6fr 1fr;
      grid-template-rows: 1fr 1fr;
      background: #FFFFFF;
      padding: clamp(14px, 2vw, 26px);
      gap: clamp(14px, 2vw, 26px);
    }

    .home-materials__cell--wide {
      grid-row: span 2;
    }

    .home-materials__cell {
      overflow: hidden;
      min-height: 0;
    }

    .home-materials__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      filter: saturate(0.9);
      transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1),
                  filter 600ms ease;
    }

    .home-materials__cell:hover .home-materials__img {
      transform: scale(1.015);
      filter: saturate(1);
    }

    /* ── Mobile : empilement vertical ───────────────────────────────────── */
    @media (max-width: 640px) {
      .home-materials__grid {
        grid-template-columns: 1fr;
        grid-template-rows: 1fr 1fr 1fr;
        padding: clamp(8px, 2vw, 14px);
        gap: clamp(8px, 2vw, 14px);
      }
      .home-materials__cell--wide {
        grid-row: span 1;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .home-materials__img {
        transition: none !important;
      }
      .home-materials__cell:hover .home-materials__img {
        transform: none !important;
      }
    }
  </style>
</MainLayout>
