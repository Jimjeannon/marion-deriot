---
/**
 * Page Info / Contact FR — /info
 * Présentation + formulaire de contact Astro Actions.
 */
import { Image } from 'astro:assets';
import MainLayout from '@/layouts/MainLayout.astro';
import { getDict } from '@/i18n';
import { getInfoDocument, resolveImageUrl } from '@/lib/sanity';

const t = getDict('fr');
const infoDoc = await getInfoDocument();
// Portrait 3:4 recadré côté Sanity (hotspot respecté) — servi en 2x pour les écrans Retina
const imageUrl = infoDoc?.image ? resolveImageUrl(infoDoc.image, 512, 683) : null;

/**
 * Rendu à la demande.
 *
 * La barre latérale liste les projets via getAllProjects(), qui interroge
 * Sanity. En page pré-rendue cette liste serait figée au moment du build : un
 * projet ajouté depuis /admin n'apparaîtrait qu'au déploiement suivant.
 */
export const prerender = false;
---

<MainLayout
  title={t.info.metaTitle}
  description={t.info.metaDescription}
  lang="fr"
  activeNav="info"
>
  <!-- Schema.org LocalBusiness (info + adresse) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    'name': 'Agence Marion Dériot',
    'url': 'https://marionderiot.com',
    'telephone': '+33686186270',
    'email': 'marionderiot.archi@gmail.com',
    'address': {
      '@type': 'PostalAddress',
      'addressLocality': 'Boulogne-Billancourt',
      'addressRegion': 'Île-de-France',
      'postalCode': '92100',
      'addressCountry': 'FR',
    },
  })} />

  <div class="px-10 py-16 lg:px-16 max-w-2xl">
    <h1 class="font-serif text-4xl font-semibold text-anthracite-300 mb-16">
      {t.info.title}
    </h1>

    <!-- ─── Photo + présentation ─────────────────────────────────────────── -->
    <div class="mb-16">
      <!-- Photo de l'architecte — image locale -->
      <img
        src="/images/marion-photo.jpg"
        alt="Marion Dériot, architecte d'intérieur"
        class="w-56 lg:w-64 aspect-[3/4] object-cover mb-10"
        width="512"
        height="683"
        loading="lazy"
      />

      <!-- Texte de présentation -->
      <div class="space-y-5 font-sans text-sm text-anthracite-300 leading-relaxed">
        <p>
          Diplômée de l'École Camondo en 1999, Marion Renaudin Dériot est architecte
          d'intérieur et designer. Après dix années d'expérience au sein d'agences
          reconnues telles que Wilmotte &amp; Associés, Bruno Moinard, Zana ou l'Agence
          Écart, elle fonde son agence en 2009.
        </p>
        <p>
          Chaque projet naît d'une lecture attentive du lieu, de ses usages et de son
          contexte. L'architecture intérieure y est envisagée comme un travail de
          composition où volumes, lumière, matières et détails dialoguent avec précision.
          La recherche d'une écriture sobre, pérenne et cohérente guide chacune des
          interventions.
        </p>
        <p>
          L'agence développe des projets sur mesure de rénovation, de réhabilitation et
          d'aménagement pour une clientèle privée et professionnelle, en accordant une
          attention particulière à la conception d'agencements sur mesure, pensés comme
          le prolongement naturel de l'architecture.
        </p>
        <p>
          Basée à Boulogne-Billancourt, l'agence intervient principalement à Paris et
          en Île-de-France, et partout en France.
        </p>
      </div>

      <!-- Bloc contact en fin de bio -->
      <address class="not-italic mt-10 space-y-1 font-sans text-sm text-greige-400">
        <p class="font-normal text-anthracite-300">Marion Dériot, Architecte d'intérieur et Design</p>
        <p>Boulogne-Billancourt</p>
        <p>
          <a
            href="mailto:marionderiot.archi@gmail.com"
            class="hover:text-anthracite-300 transition-colors duration-400"
          >
            marionderiot.archi@gmail.com
          </a>
        </p>
        <p>
          <a
            href="tel:+33686186270"
            class="hover:text-anthracite-300 transition-colors duration-400"
          >
            06 86 18 62 70
          </a>
        </p>
      </address>
    </div>

    <!-- ─── Formulaire de contact ─────────────────────────────────────────── -->
    <section aria-labelledby="contact-title">
      <h2
        id="contact-title"
        class="font-serif text-2xl font-semibold text-anthracite-300 mb-8"
      >
        {t.info.contactTitle}
      </h2>

      <!--
        Astro Actions — à configurer dans src/actions/index.ts
        Rate limiting + validation Zod côté serveur obligatoires (CLAUDE.md)
      -->
      <form
        id="contact-form"
        method="POST"
        action="/api/contact"
        class="space-y-6"
        novalidate
      >
        <!-- Nom -->
        <div>
          <label
            for="name"
            class="block font-sans text-xs tracking-wide text-greige-400 mb-2"
          >
            {t.info.form.name}
            <span class="text-accent ml-1" aria-hidden="true">*</span>
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            autocomplete="name"
            class="w-full border-b border-greige-200 bg-transparent py-2 font-sans text-sm text-anthracite-300 placeholder-greige-300 focus:border-anthracite-300 focus:outline-none transition-colors duration-400"
          />
        </div>

        <!-- Email -->
        <div>
          <label
            for="email"
            class="block font-sans text-xs tracking-wide text-greige-400 mb-2"
          >
            {t.info.form.email}
            <span class="text-accent ml-1" aria-hidden="true">*</span>
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            class="w-full border-b border-greige-200 bg-transparent py-2 font-sans text-sm text-anthracite-300 placeholder-greige-300 focus:border-anthracite-300 focus:outline-none transition-colors duration-400"
          />
        </div>

        <!-- Type de projet -->
        <div>
          <label
            for="project-type"
            class="block font-sans text-xs tracking-wide text-greige-400 mb-2"
          >
            {t.info.form.projectType}
          </label>
          <select
            id="project-type"
            name="projectType"
            class="w-full border-b border-greige-200 bg-transparent py-2 font-sans text-sm text-anthracite-300 focus:border-anthracite-300 focus:outline-none transition-colors duration-400 appearance-none cursor-pointer"
          >
            <option value="">—</option>
            <option value="residential">{t.info.form.projectTypes.residential}</option>
            <option value="commercial">{t.info.form.projectTypes.commercial}</option>
            <option value="hospitality">{t.info.form.projectTypes.hospitality}</option>
            <option value="other">{t.info.form.projectTypes.other}</option>
          </select>
        </div>

        <!-- Message -->
        <div>
          <label
            for="message"
            class="block font-sans text-xs tracking-wide text-greige-400 mb-2"
          >
            {t.info.form.message}
            <span class="text-accent ml-1" aria-hidden="true">*</span>
          </label>
          <textarea
            id="message"
            name="message"
            required
            rows={5}
            placeholder={t.info.form.messagePlaceholder}
            class="w-full border-b border-greige-200 bg-transparent py-2 font-sans text-sm text-anthracite-300 placeholder-greige-300 focus:border-anthracite-300 focus:outline-none transition-colors duration-400 resize-none"
          ></textarea>
        </div>

        <!-- Honeypot anti-spam (invisible) -->
        <div class="sr-only" aria-hidden="true">
          <label for="website">Ne pas remplir</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <!-- Submit -->
        <button
          type="submit"
          id="submit-btn"
          class="font-sans text-xs tracking-[0.2em] uppercase text-anthracite-300 border-b border-anthracite-300 pb-0.5 hover:text-accent hover:border-accent transition-colors duration-400"
        >
          {t.info.form.submit}
        </button>

        <!-- Feedback -->
        <div id="form-feedback" class="hidden" role="alert" aria-live="polite">
          <p id="feedback-message" class="font-sans text-sm"></p>
        </div>
      </form>
    </section>
  </div>
</MainLayout>

<script>
  // Validation côté client légère + feedback UX
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const feedback = document.getElementById('form-feedback') as HTMLDivElement;
  const feedbackMsg = document.getElementById('feedback-message') as HTMLParagraphElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Honeypot check
      const honey = (form.elements.namedItem('website') as HTMLInputElement)?.value;
      if (honey) return;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Envoi en cours…';

      try {
        const data = new FormData(form);
        const res = await fetch('/api/contact', {
          method: 'POST',
          body: data,
        });

        if (res.ok) {
          form.reset();
          showFeedback('Merci pour votre message. Marion vous répondra dans les meilleurs délais.', true);
        } else {
          throw new Error('Server error');
        }
      } catch {
        showFeedback('Votre message n\'a pas pu être envoyé. Veuillez réessayer.', false);
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Envoyer';
      }
    });
  }

  function showFeedback(message: string, success: boolean) {
    if (!feedback || !feedbackMsg) return;
    feedbackMsg.textContent = message;
    feedbackMsg.className = `font-sans text-sm ${success ? 'text-anthracite-300' : 'text-accent'}`;
    feedback.classList.remove('hidden');
  }
</script>
