---
import MainLayout from '@/layouts/MainLayout.astro';
---

<MainLayout
  title="Politique de cookies — Marion Dériot"
  description="Politique d'utilisation des cookies — Agence Marion Dériot."
  lang="fr"
>
  <div class="px-10 py-16 lg:px-16 max-w-2xl">
    <h1 class="font-serif text-3xl font-light text-anthracite-300 mb-12">
      Cookies
    </h1>

    <div class="space-y-8 font-sans text-sm text-anthracite-300 leading-relaxed">
      <p>
        Ce site n'utilise pas de cookies publicitaires, ni de cookies de tracking tiers.
      </p>
      <section>
        <h2 class="font-sans text-xs tracking-[0.2em] uppercase text-greige-400 mb-4">Analytics</h2>
        <p>
          L'outil de mesure d'audience Plausible Analytics ne dépose aucun cookie
          et ne collecte aucune donnée personnelle identifiable.
          Aucun consentement n'est requis pour son utilisation.
        </p>
      </section>
      <section>
        <h2 class="font-sans text-xs tracking-[0.2em] uppercase text-greige-400 mb-4">Cookies fonctionnels</h2>
        <p>
          Aucun cookie fonctionnel n'est actuellement utilisé sur ce site.
        </p>
      </section>
    </div>
  </div>
</MainLayout>
