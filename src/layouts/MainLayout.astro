---
/**
 * MainLayout — Layout principal avec sidebar gauche fixe.
 * Utilisé par toutes les pages après la landing : /home, /projets, /info, pages légales.
 */
import '@/styles/globals.css';
import { ViewTransitions } from 'astro:transitions';
import Sidebar from '@/components/layout/Sidebar.astro';
import { getDict } from '@/i18n';

interface Props {
  title: string;
  description: string;
  lang?: 'fr' | 'en';
  canonicalURL?: string;
  ogImage?: string;
  /** Clé de navigation active — pour l'indicateur visuel dans la sidebar */
  activeNav?: 'home' | 'projects' | 'info';
}

const {
  title,
  description,
  lang = 'fr',
  canonicalURL = Astro.url.href,
  ogImage,
  activeNav,
} = Astro.props;

const t = getDict(lang);
const siteName = 'Marion Dériot — Architecte d\'intérieur';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Titre -->
    <title>{title}</title>

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- hreflang FR -->
    <link rel="alternate" hreflang="fr" href={`${Astro.site}home`} />
    <link rel="alternate" hreflang="x-default" href={`${Astro.site}home`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={title} />}
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Plausible Analytics — cookieless, hébergé EU, aucun consentement requis -->
    <!-- À activer en remplaçant le domain par le vrai domaine -->
    <!-- <script defer data-domain="marionderiot.com" src="https://plausible.io/js/script.js"></script> -->

    <!-- View Transitions Astro -->
    <ViewTransitions />

    <!--
      Slot « head » — permet à une page d'injecter ses propres balises dans le
      <head> : préchargement de l'image LCP, données structurées, etc.
      Indispensable pour tenir le budget LCP < 2.0 s.
    -->
    <slot name="head" />

    <style>
      /**
       * Transition "ouverture de porte" pour l'arrivée depuis la landing.
       *
       * Quand l'utilisateur clique sur "Entrer" :
       *  1. La landing ferme ses deux panneaux (animé en JS côté landing)
       *  2. Le navigateur charge /home — View Transitions intercepte
       *  3. Le MainLayout reçoit la page avec une animation d'entrée :
       *     le contenu monte depuis le bas (comme on entre dans une pièce)
       *     tandis que les faux panneaux "porte" s'écartent.
       *
       * Entre pages internes (home → projets, projets → info, etc.) :
       *  simple fondu latéral subtil — évoque le passage d'une pièce à l'autre.
       */

      /* Transition entre pages internes — glissement horizontal discret */
      @keyframes slideInRight {
        from { opacity: 0; transform: translateX(18px); }
        to   { opacity: 1; transform: translateX(0);    }
      }
      @keyframes slideOutLeft {
        from { opacity: 1; transform: translateX(0);     }
        to   { opacity: 0; transform: translateX(-18px); }
      }

      /* Entrée depuis la landing — le contenu monte légèrement */
      @keyframes riseIn {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0);    }
      }

      /* Appliquer aux éléments qui participent aux View Transitions */
      ::view-transition-old(main-content) {
        animation: 380ms cubic-bezier(0.4, 0, 1, 1) both slideOutLeft;
      }
      ::view-transition-new(main-content) {
        animation: 450ms cubic-bezier(0.0, 0, 0.2, 1) 60ms both slideInRight;
      }

      /* Sidebar — reste fixe pendant les transitions (pas d'animation) */
      ::view-transition-old(sidebar),
      ::view-transition-new(sidebar) {
        animation: none;
      }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(main-content),
        ::view-transition-new(main-content) {
          animation: none !important;
        }
      }
    </style>
  </head>
  <body class="bg-ivory text-anthracite-300">
    <!-- Skip link accessibilité -->
    <a href="#main-content" class="skip-link">
      {t.nav.skipToContent}
    </a>

    <!-- Sidebar gauche fixe (desktop) / drawer (mobile) -->
    <Sidebar lang={lang} activeNav={activeNav} />

    <!-- Contenu principal — nommé pour View Transitions -->
    <main
      id="main-content"
      class="main-content"
      style="view-transition-name: main-content;"
    >
      <slot />
    </main>
  </body>
</html>
