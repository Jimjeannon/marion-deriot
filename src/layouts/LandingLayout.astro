---
/**
 * LandingLayout — Layout minimaliste pour la page d'entrée (/ et /en/)
 * Pas de sidebar, pas de navigation, pas de footer.
 * Contient uniquement le slideshow de fond et l'élément d'entrée.
 */
import '@/styles/globals.css';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  lang?: 'fr' | 'en';
  canonicalURL?: string;
  ogImage?: string;
}

const {
  title,
  description,
  lang = 'fr',
  canonicalURL = Astro.url.href,
  ogImage,
} = Astro.props;

const siteName = 'Marion Dériot — Architecte d\'intérieur';
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Critique : aucun flash titre/fond ivoire avant la 1ère image (exécuté avant le CSS bundle) -->
    <style is:inline>
      html.landing-pending,
      html.landing-pending body {
        margin: 0;
        /* Priorité sur globals.css (ivoire) — pas de flash blanc + titre clair */
        background-color: #141312 !important;
      }
      html.landing-pending .landing-chrome {
        visibility: hidden;
        opacity: 0;
      }
      html.landing-pending .slide {
        opacity: 0 !important;
      }
      html.landing-ready .slide--on {
        opacity: 1 !important;
      }
      html.landing-ready .landing-chrome {
        visibility: visible;
        opacity: 1;
        transition: opacity 600ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
      }
    </style>
    <script is:inline>
      document.documentElement.classList.add('landing-pending');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Titre -->
    <title>{title}</title>

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- hreflang FR/EN -->
    <link rel="alternate" hreflang="fr" href={Astro.site} />
    <link rel="alternate" hreflang="en" href={`${Astro.site}en/`} />
    <link rel="alternate" hreflang="x-default" href={Astro.site} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- View Transitions Astro -->
    <ViewTransitions />

    <!-- Slot tête de page (preload images, etc.) -->
    <slot name="head" />

    <style>
      /**
       * Transition landing → /home.
       * Le voile ivoire couvre déjà la landing quand la navigation démarre.
       * La nouvelle page émerge en fondu simple depuis cet ivoire.
       */
      ::view-transition-old(root) {
        animation: none;
      }
      /* Pas de fondu à l'arrivée sur la landing — évite un écran vide au chargement */
      ::view-transition-new(root) {
        animation: none;
      }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none !important;
        }
      }

      html.landing-ready,
      html.landing-ready body {
        background-color: transparent;
      }
    </style>
  </head>
  <body class="overflow-hidden">
    <!-- Skip link accessibilité -->
    <a href="#landing-skip-target" class="skip-link">
      Aller au contenu
    </a>

    <main id="landing-skip-target">
      <slot />
    </main>
  </body>
</html>
