---
/**
 * Homepage FR — /home
 * Diaporama plein-écran automatique — 6 diapositives de 2 images, répartition 50/50.
 * Chaque diapositive est présentée dans un cadre blanc identique aux pages projets.
 * Crossfade + Ken Burns, prefers-reduced-motion respecté.
 *
 * Images : servies via astro:assets (<Picture>) — AVIF prioritaire, repli WebP,
 * srcset responsive, largeur/hauteur intrinsèques émises pour un CLS nul.
 */
import MainLayout from '@/layouts/MainLayout.astro';
import { Picture } from 'astro:assets';
import { getDict } from '@/i18n';

// ── Sources des 12 images de la home ───────────────────────────────────────
// Les fichiers vivent dans src/assets/home/ : ils passent ainsi par le pipeline
// d'optimisation d'Astro (sharp) au lieu d'être servis bruts depuis /public.
import img01Lavoisier from '@/assets/home/01-lavoisier-salon-sculpture-anneaux.webp';
import img02Vertbois from '@/assets/home/02-vertbois-cave-a-vin-brique-de-verre.webp';
import img03Bourdonnais from '@/assets/home/03-bourdonnais-faience-striee.webp';
import img04Breteuil from '@/assets/home/04-breteuil-cuisine-quartzite-laiton.webp';
import img05Quartzite from '@/assets/home/05-quartzite-rose-mitigeurs-inox.webp';
import img06Cdg from '@/assets/home/06-cdg-bibliotheque-metal-noir.webp';
import img07RouleEscalier from '@/assets/home/07-square-du-roule-escalier-metal.webp';
import img08RoulePortes from '@/assets/home/08-square-du-roule-portes-pliantes.webp';
import img09Hervieu from '@/assets/home/09-hervieu-claustra-chene.webp';
import img10Rebeval from '@/assets/home/10-rebeval-lampadaire-globe.webp';
import img11Cambaceres from '@/assets/home/11-cambaceres-miroir-boules-quartzite.webp';
import img12Vaucresson from '@/assets/home/12-vaucresson-miroirs-ovales-chene.webp';

const t = getDict('fr');

const pageTitle = t.home.metaTitle;
const pageDescription = t.home.metaDescription;

/**
 * Les 12 images de la home, dans l'ordre du schéma de rendu validé par la cliente.
 *
 *   1 Lavoisier          2 Vertbois      |  3 Bourdonnais      4 Breteuil
 *   5 projet non publié  6 CDG           |  7 Square du Roule  8 Square du Roule
 *   9 Hervieu           10 Rebeval       | 11 Cambacérès      12 Vaucresson
 *
 * `slug` vaut null pour les projets sans fiche publiée (5 et 10) : l'image
 * renvoie alors vers la liste des projets, jamais vers une URL inexistante.
 *
 * `alt` décrit la matière et l'ouvrage — utile aux lecteurs d'écran comme au
 * référencement d'images. Jamais de liste de mots-clés.
 */
type HomeImage = {
  src: ImageMetadata;
  alt: string;
  slug: string | null;
  title: string;
};

const M = {
  lavoisier: {
    src: img01Lavoisier,
    alt: "Salon du projet Lavoisier — double anneau de métal noir devant l'escalier suspendu en béton",
    slug: 'lavoisier', title: 'LAVOISIER',
  },
  vertbois: {
    src: img02Vertbois,
    alt: 'Projet Vertbois — cave à vin derrière une paroi de briques de verre ondulé',
    slug: 'vertbois', title: 'VERTBOIS',
  },
  bourdonnais: {
    src: img03Bourdonnais,
    alt: 'Projet Bourdonnais — faïence crème à stries horizontales, calepinage repris en angle',
    slug: 'bourdonnais', title: 'BOURDONNAIS',
  },
  breteuil: {
    src: img04Breteuil,
    alt: 'Projet Breteuil — plan et crédence en quartzite veiné, robinetterie en laiton, façades striées',
    slug: 'breteuil', title: 'BRETEUIL',
  },
  quartzite: {
    src: img05Quartzite,
    alt: "Salle d'eau sur mesure — crédence en quartzite rosé et mitigeurs encastrés en inox brossé",
    slug: null, title: 'MARION DÉRIOT',
  },
  cdg: {
    src: img06Cdg,
    alt: 'Projet CDG à Boulogne-Billancourt — bibliothèque en métal noir, composition orthogonale sur mur clair',
    slug: 'charles-de-gaulle', title: 'CDG BOULOGNE-BILLANCOURT',
  },
  rouleA: {
    src: img07RouleEscalier,
    alt: 'Projet Square du Roule — escalier en pierre et garde-corps en métal noir à barreaudage horizontal',
    slug: 'square-du-roule', title: 'SQUARE DU ROULE',
  },
  rouleB: {
    src: img08RoulePortes,
    alt: 'Projet Square du Roule — portes pliantes vitrées à cadres en métal noir',
    slug: 'square-du-roule', title: 'SQUARE DU ROULE',
  },
  hervieu: {
    src: img09Hervieu,
    alt: 'Projet Hervieu — claustra de tasseaux de chêne clair et façades en placage',
    slug: 'hervieu', title: 'HERVIEU',
  },
  rebeval: {
    src: img10Rebeval,
    alt: 'Projet Rebeval — lampadaire à globe opalin sur pied de laiton, rideau de lin et corniche lumineuse',
    slug: null, title: 'REBEVAL',
  },
  cambaceres: {
    src: img11Cambaceres,
    alt: 'Projet Cambacérès — miroir à cadre de boules tournées en bois et plan en quartzite doré',
    slug: 'cambaceres', title: 'CAMBACERES',
  },
  vaucresson: {
    src: img12Vaucresson,
    alt: 'Projet Vaucresson — miroirs ovales et façades cintrées en chêne, double vasque en marbre',
    slug: 'vaucresson', title: 'VAUCRESSON',
  },
} satisfies Record<string, HomeImage>;

/**
 * Frames du diaporama — 6 diapositives de 2 images, répartition 50/50.
 */
const frames: { images: HomeImage[] }[] = [
  { images: [M.lavoisier, M.vertbois] },
  { images: [M.bourdonnais, M.breteuil] },
  { images: [M.quartzite, M.cdg] },
  { images: [M.rouleA, M.rouleB] },
  { images: [M.hervieu, M.rebeval] },
  { images: [M.cambaceres, M.vaucresson] },
];

/* Mobile : liste plate — chaque image défile individuellement, dans l'ordre. */
const mobileImages = frames.flatMap((frame) => frame.images);

/** Destination d'une image : sa fiche projet, ou la liste si le projet n'est pas publié. */
const linkFor = (img: HomeImage) => (img.slug ? `/projets/${img.slug}` : '/projets');
const labelFor = (img: HomeImage) =>
  img.slug ? `${t.projects.viewProject} ${img.title}` : t.home.seeAllProjects;

/**
 * Chaque cellule occupe la moitié de la largeur au-dessus de 768 px, la totalité
 * en dessous. Les largeurs générées couvrent mobile, tablette, desktop et 2×.
 */
const CELL_SIZES = '(max-width: 767px) 100vw, 50vw';
const CELL_WIDTHS = [480, 760, 1040, 1400];

/** Image partagée pour Open Graph / Twitter Card. */
const ogImage = new URL(img01Lavoisier.src, Astro.site).href;

/** URL absolue d'une image, pour les données structurées. */
const abs = (src: string) => new URL(src, Astro.site).href;
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  lang="fr"
  activeNav="home"
  ogImage={ogImage}
>
  {/*
    Préchargement de la première diapositive : ses deux images constituent le LCP.
    Sans cela le navigateur ne les découvre qu'après le parsing du corps de page.
  */}
  <Fragment slot="head">
    <link rel="preload" as="image" href={img01Lavoisier.src} fetchpriority="high" />
    <link rel="preload" as="image" href={img02Vertbois.src} fetchpriority="high" />
  </Fragment>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    '@id': 'https://marionderiot.com/#agence',
    'name': 'Agence Marion Dériot architecture intérieure & design',
    'alternateName': ['Marion Renaudin Dériot', 'Marion Renaudin', 'Agence Marion Dériot'],
    'description': pageDescription,
    'url': 'https://marionderiot.com',
    'telephone': '+33686186270',
    'email': 'marionderiot.archi@gmail.com',
    'image': [abs(img01Lavoisier.src), abs(img04Breteuil.src), abs(img11Cambaceres.src)],
    'founder': {
      '@type': 'Person',
      'name': 'Marion Dériot',
      'jobTitle': "Architecte d'intérieur",
      'alumniOf': { '@type': 'CollegeOrUniversity', 'name': 'École Camondo' },
    },
    'address': { '@type': 'PostalAddress', 'addressLocality': 'Boulogne-Billancourt', 'addressRegion': 'Île-de-France', 'addressCountry': 'FR' },
    'geo': { '@type': 'GeoCoordinates', 'latitude': 48.8396, 'longitude': 2.2297 },
    'areaServed': [
      { '@type': 'City', 'name': 'Boulogne-Billancourt' },
      { '@type': 'City', 'name': 'Paris' },
      { '@type': 'State', 'name': 'Île-de-France' },
    ],
    'priceRange': '€€€',
    'sameAs': ['https://www.instagram.com/marionderiot', 'https://www.linkedin.com/in/marionderiot'],
  })} />

  {/*
    Galerie d'images déclarée séparément : chaque photo est rattachée à sa fiche
    projet, ce qui permet à Google Images de relier l'image à la bonne page.
  */}
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ImageGallery',
    'name': 'Réalisations — Agence Marion Dériot',
    'description': pageDescription,
    'url': 'https://marionderiot.com/home',
    'author': { '@id': 'https://marionderiot.com/#agence' },
    'associatedMedia': mobileImages.map((img) => ({
      '@type': 'ImageObject',
      'contentUrl': abs(img.src.src),
      'caption': img.alt,
      'representativeOfPage': img === M.lavoisier,
      ...(img.slug ? { 'mainEntityOfPage': `https://marionderiot.com/projets/${img.slug}` } : {}),
    })),
  })} />

  <h1 class="sr-only">{t.home.h1}</h1>

  <!-- ── Diaporama home ─────────────────────────────────────────────────── -->
  <section class="hs" aria-label={t.home.slideshowLabel} aria-roledescription="diaporama" id="home-slideshow">

    {frames.map((frame, fi) => {
      const isActive = fi === 0;
      const tabI = isActive ? '0' : '-1';

      return (
        <div
          class={`hs-frame${isActive ? ' hs-frame--active' : ''}`}
          data-frame={fi}
          role="group"
          aria-roledescription="diapositive"
          aria-label={`Diapositive ${fi + 1} sur ${frames.length}`}
          aria-hidden={!isActive ? 'true' : 'false'}
        >
          {/* Cadre blanc — 22px tout autour et entre les deux images */}
          <div class="hs-board">
            {frame.images.map((img) => (
              <a
                href={linkFor(img)}
                class="hs-cell"
                tabindex={tabI}
                aria-label={labelFor(img)}
              >
                <Picture
                  src={img.src}
                  alt={img.alt}
                  formats={['avif', 'webp']}
                  widths={CELL_WIDTHS}
                  sizes={CELL_SIZES}
                  class="hs-img"
                  loading={isActive ? 'eager' : 'lazy'}
                  decoding="async"
                  fetchpriority={isActive ? 'high' : 'auto'}
                />
              </a>
            ))}
          </div>
        </div>
      );
    })}

  </section>

  <!-- ── Diaporama mobile — chaque image défile une par une ─────────────────── -->
  <section class="hsm" aria-label={t.home.slideshowLabel} aria-roledescription="diaporama" id="home-slideshow-mobile">
    {mobileImages.map((img, mi) => (
      <div
        class={`hsm-slide${mi === 0 ? ' hsm-slide--active' : ''}`}
        data-mslide={mi}
        role="group"
        aria-roledescription="diapositive"
        aria-label={`Diapositive ${mi + 1} sur ${mobileImages.length}`}
        aria-hidden={mi === 0 ? 'false' : 'true'}
      >
        <div class="hsm-board">
          <a
            href={linkFor(img)}
            class="hsm-cell"
            tabindex={mi === 0 ? '0' : '-1'}
            aria-label={labelFor(img)}
          >
            <Picture
              src={img.src}
              alt={img.alt}
              formats={['avif', 'webp']}
              widths={CELL_WIDTHS}
              sizes="100vw"
              class="hs-img"
              loading={mi === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </a>
        </div>
      </div>
    ))}
  </section>
</MainLayout>
